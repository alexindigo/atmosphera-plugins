{
  "id": "catwalk",
  "name": "Catwalk",
  "version": "1.1.16",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "MannuVilasara",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A cute animated cat for your bar.",
  "tags": [
    "Bar",
    "Desktop",
    "Panel",
    "Fun"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "desktopWidget": "DesktopWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "hideBackground": {"type": "Boolean", "editorUsage": "configuration"},
        "minimumThreshold": {"type": "Real", "editorUsage": "configuration"}
      }
    },
    "defaultSettings": {
      "minimumThreshold": 10,
      "hideBackground": false
    }
  }
}
