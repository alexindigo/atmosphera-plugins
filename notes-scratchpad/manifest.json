{
  "id": "notes-scratchpad",
  "name": "Notes Scratchpad",
  "version": "1.1.11",
  "minNoctaliaVersion": "3.7.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "apt-get",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A simple scratchpad for quick notes.",
  "tags": [
    "Bar",
    "Panel",
    "Productivity"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "scratchpadContent": {"type": "String", "machineLocal": true},
        "cursorPosition": {"type": "Real", "machineLocal": true},
        "scrollPositionX": {"type": "Real", "machineLocal": true},
        "scrollPositionY": {"type": "Real", "machineLocal": true},
        "filePath": {"type": "String"},
        "fontSize": {"type": "Real"},
        "panelHeight": {"type": "Real"},
        "panelWidth": {"type": "Real"},
        "useMonospace": {"type": "Boolean", "optional": true}
      }
    },
    "defaultSettings": {
      "scratchpadContent": "",
      "cursorPosition": 0,
      "scrollPositionX": 0,
      "scrollPositionY": 0,
      "panelWidth": 600,
      "panelHeight": 400,
      "fontSize": 14,
      "filePath": ""
    }
  }
}
