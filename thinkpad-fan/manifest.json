{
    "id": "thinkpad-fan",
    "name": "ThinkPad - Fan & Thermal Control",
    "version": "1.1.5",
    "minNoctaliaVersion": "4.0.0",
    "minAtmospheraVersion": "0.10.0",
    "author": "Piero-93",
    "license": "GPLv3",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "description": "Monitors system temperatures and provides manual overrides for fan speed profiles via sysfs.",
    "tags": ["Bar", "Indicator", "System", "Utility"],
    "entryPoints": {
        "barWidget": "BarWidget.qml",
        "panel": "FanPopup.qml",
        "settings": "SettingsView.qml"
    },
    "metadata": {
        "settingsSchema": {
            "version": 1,
            "fields": {
                "allowPopupOpening": {"editorUsage": "configuration", "type": "Boolean"},
                "colorActive": {"editorUsage": "configuration", "type": "String", "nullable": true},
                "colorAuto": {"editorUsage": "configuration", "type": "String", "nullable": true},
                "colorLevel0": {"editorUsage": "configuration", "type": "String", "nullable": true},
                "colorizeByStatus": {"editorUsage": "configuration", "type": "Boolean"}
            }
        },
        "defaultSettings": {
            "colorizeByStatus": true,
            "allowPopupOpening": true,
            "colorLevel0": null,
            "colorActive": null,
            "colorAuto": null
        }
    }
}
