{
  "id": "saved-desktop-widgets",
  "name": "Saved Desktop Widgets",
  "version": "1.0.7",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "spiros132",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A plugin that allows you to have multiple setups for your desktop widgets based on the wallpaper.",
  "tags": ["Fun", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "definitions": {
        "widget": {"type": "Record", "fields": {"id": {"type": "String"}, "instanceSettings": {"type": "Record", "optional": true, "fields": {}}}},
        "monitor": {"type": "Record", "fields": {"name": {"type": "String"}, "widgets": {"type": "List", "element": {"ref": "widget"}}}}
      },
      "fields": {
        "loadWidgets": {"type": "Boolean", "editorUsage": "configuration"},
        "monitorWidgets": {"type": "Map", "editorUsage": "content", "optional": true, "machineLocal": true, "element": {"type": "List", "element": {"ref": "monitor"}}},
        "saveWidgets": {"type": "Boolean", "editorUsage": "configuration"}
      }
    },
    "defaultSettings": {
      "saveWidgets": true,
      "loadWidgets": true
    }
  }
}
