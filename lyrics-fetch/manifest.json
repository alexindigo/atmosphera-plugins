{
  "id": "lyrics-fetch",
  "name": "Lyrics Fetch/Bar Display",
  "version": "1.1.7",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Pever3ll",
  "license": "GPLv3",
  "description": "Uses MPRIS data to fetch song lyrics from lrclib.net and displays it in the bar.",
  "tags": [
    "Bar",
    "Music"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "adaptScrollSpeed": {"editorUsage": "configuration", "type": "Boolean"},
        "fontFamily": {"editorUsage": "configuration", "type": "String","optional": true},
        "fontSize": {"editorUsage": "configuration", "type": "Real"},
        "hideWhenEmpty": {"editorUsage": "configuration", "type": "Boolean"},
        "hideWhenPaused": {"editorUsage": "configuration", "type": "Boolean","optional": true},
        "scrollMode": {"editorUsage": "configuration", "type": "String"},
        "scrollSpeed": {"editorUsage": "configuration", "type": "Real"},
        "verticalRotationDirection": {"editorUsage": "configuration", "type": "String"},
        "widgetWidth": {"editorUsage": "configuration", "type": "Real"}
      }
    },
    "defaultSettings": {
      "widgetWidth": 300,
      "scrollSpeed": 70,
      "fontSize": 10,
      "scrollMode": "always",
      "hideWhenEmpty": true,
      "adaptScrollSpeed": true,
      "verticalRotationDirection": "auto"
    }
  },
  "repository": "https://github.com/noctalia-dev/noctalia-plugins"
}
