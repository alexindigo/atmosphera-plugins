{
  "id": "squeekboard-toggle",
  "name": "Squeekboard Toggle",
  "version": "1.1.5",
  "minNoctaliaVersion": "4.4.3",
  "minAtmospheraVersion": "0.10.0",
  "author": "blackteaextract",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Toggle the Squeekboard on-screen keyboard with live availability detection, hover icons, and configurable settings. Note: This plugin is deprecated and got consolidated in osk-toggle.",
  "tags": [
    "System",
    "Bar",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "disableHoverIcon": {"editorUsage": "configuration", "type": "Boolean"},
        "hideWhenUnavailable": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "hideWhenUnavailable": false,
      "disableHoverIcon": false
    }
  }
}
