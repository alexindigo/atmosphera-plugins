{
  "id": "somnus",
  "name": "somnus",
  "version": "1.0.9",
  "minNoctaliaVersion": "4.7.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "yhordi45",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A full-screen power menu for Noctalia Shell, inspired by the wlogout design.",
  "tags": ["Bar", "Panel", "Hyprland", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "animationsEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "buttonHeight": {"editorUsage": "configuration", "type": "Real"},
        "buttonOpacity": {"editorUsage": "configuration", "type": "Real"},
        "buttonSpacing": {"editorUsage": "configuration", "type": "Real"},
        "buttonWidth": {"editorUsage": "configuration", "type": "Real"},
        "hoverColor": {"editorUsage": "configuration", "type": "String"},
        "hoverDesaturation": {"editorUsage": "configuration", "type": "Real"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "lockOnSuspend": {"editorUsage": "configuration", "type": "Boolean"},
        "overlayBlur": {"editorUsage": "configuration", "type": "Real"},
        "overlayTint": {"editorUsage": "configuration", "type": "Real"},
        "panelTint": {"editorUsage": "configuration", "type": "Real"},
        "useOverlay": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "iconColor": "primary",
      "hoverColor": "primary",
      "buttonWidth": 470,
      "buttonHeight": 280,
      "buttonSpacing": 20,
      "buttonOpacity": 0.50,
      "useOverlay": true,
      "overlayBlur": 0.75,
      "overlayTint": 0.6,
      "panelTint": 0.7,
      "animationsEnabled": true,
      "lockOnSuspend": true,
      "hoverDesaturation": 0.0
    }
  }
}
