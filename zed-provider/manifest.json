{
  "id": "zed-provider",
  "name": "Zed Provider",
  "version": "1.0.6",
  "author": "justKevv",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A zed provider for opening project easier using zed code editor",
  "tags": ["Launcher", "Developer"],
  "minNoctaliaVersion": "3.6.0",
  "entryPoints": {
    "main": "Main.qml",
    "launcherProvider": "ZedProvider.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "zed",
    "settingsSchema": {
      "version": 1,
      "fields": {
        "openCounts": {"type": "Map", "machineLocal": true, "element": {"type": "Real"}}
      }
    },
    "defaultSettings": {"openCounts": {}}
  }
}
