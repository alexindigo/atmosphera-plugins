{
  "id": "update-count",
  "name": "Update Count",
  "version": "1.0.17",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "BukoMoon",
  "license": "GPLv3",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Checks for system updates and shows the update count. Click to run update command in a terminal.",
  "tags": [
    "Bar",
    "System"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "currentIconName": {"type": "String"},
        "customCmdDoSystemUpdate": {"type": "String", "optional": true},
        "customCmdGetNumUpdates": {"type": "String", "optional": true},
        "hideOnZero": {"type": "Boolean"},
        "updateIntervalMinutes": {"type": "Real"},
        "updateTerminalCommand": {"type": "String"}
      }
    },
    "defaultSettings": {
      "updateIntervalMinutes": 30,
      "updateTerminalCommand": "foot -e",
      "currentIconName": "world-download",
      "hideOnZero": false
    }
  }
}
