{
  "id": "ds4-colors",
  "name": "DS4 Colors",
  "version": "1.0.3",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.10.0",
  "author": "Hy4ri",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Change the lightbar color of your DualShock 4 or DualSense controller with a color picker and recent color history.",
  "tags": [
    "Hardware",
    "Gaming",
    "Bar"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "color": {"type": "String"},
        "colorIcon": {"type": "Boolean"},
        "hideOnEmpty": {"type": "Boolean"},
        "recentColors": {"type": "List", "machineLocal": true, "element": {"type": "String"}}
      }
    },
    "defaultSettings": {
      "color": "#0064ff",
      "colorIcon": false,
      "hideOnEmpty": false,
      "recentColors": []
    }
  }
}
