{
  "id": "world-clock",
  "name": "World Clock",
  "version": "1.0.7",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.8.0",
  "author": "Lokize",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Display time from multiple timezones around the world with automatic rotation.",
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "rotationInterval": {"type": "Real"},
        "showDate": {"type": "Boolean"},
        "timeFormat": {"type": "String"},
        "timezones": {"type": "List", "element": {"type": "Record", "fields": {"name": {"type": "String"}, "timezone": {"type": "String"}, "enabled": {"type": "Boolean"}}}}
      }
    },
    "defaultSettings": {
      "timezones": [
        {
          "name": "New York",
          "timezone": "America/New_York",
          "enabled": true
        },
        {
          "name": "London",
          "timezone": "Europe/London",
          "enabled": true
        },
        {
          "name": "Tokyo",
          "timezone": "Asia/Tokyo",
          "enabled": true
        }
      ],
      "rotationInterval": 5000,
      "showDate": true,
      "timeFormat": "HH:mm"
    }
  }
}
