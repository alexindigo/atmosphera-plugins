{
  "id": "hassio",
  "name": "Home Assistant",
  "version": "1.1.4",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Pozzoo",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Monitor and control Home Assistant entities from the bar. Requires qt6-websockets.",
  "tags": ["Bar", "Panel", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "entities": {"type": "List","element": {"type": "String"}},
        "haToken": {"type": "String", "sensitive": true, "machineLocal": true},
        "haUrl": {"type": "String"}
      }
    },
    "defaultSettings": {
      "haUrl": "",
      "haToken": "",
      "entities": []
    }
  }
}
