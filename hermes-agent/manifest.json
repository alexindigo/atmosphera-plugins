{
  "id": "hermes-agent",
  "name": "Hermes Agent",
  "version": "1.1.6",
  "minNoctaliaVersion": "4.4.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "nomadx, FelipeMayerDev",
  "license": "MIT",
  "description": "Native Noctalia status and side-panel interface for Hermes Agent. Supports a client-only mode to drive a Hermes bridge running on a remote server over SSH.",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "tags": [
    "Bar",
    "Panel",
    "Launcher",
    "AI"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "hermes",
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoStartBridge": {"editorUsage": "configuration", "type": "Boolean"},
        "autoStartGateway": {"editorUsage": "configuration", "type": "Boolean"},
        "bridgeHost": {"editorUsage": "configuration", "type": "String"},
        "bridgePort": {"editorUsage": "configuration", "type": "Real"},
        "bridgeTokenManual": {"editorUsage": "configuration", "type": "String"},
        "clientOnlyMode": {"editorUsage": "configuration", "type": "Boolean"},
        "configured": {"editorUsage": "operational", "type": "Boolean"},
        "defaultModel": {"editorUsage": "configuration", "type": "String"},
        "defaultProvider": {"editorUsage": "configuration", "type": "String"},
        "hermesCommand": {"editorUsage": "configuration", "type": "String"},
        "hermesHome": {"editorUsage": "configuration", "type": "String"},
        "hideWhenIdle": {"editorUsage": "configuration", "type": "Boolean"},
        "launcherPrefix": {"editorUsage": "configuration", "type": "String"},
        "panelPinned": {"editorUsage": "configuration", "type": "Boolean"},
        "showToolActivity": {"editorUsage": "configuration", "type": "Boolean"},
        "stateFile": {"editorUsage": "configuration", "type": "String"},
        "statusPollIntervalSec": {"editorUsage": "configuration", "type": "Real"}
      }
    },
    "defaultSettings": {
      "bridgeHost": "127.0.0.1",
      "bridgePort": 19777,
      "stateFile": "~/.cache/noctalia-hermes/state.json",
      "hermesHome": "~/.hermes",
      "hermesCommand": "hermes",
      "autoStartBridge": true,
      "autoStartGateway": true,
      "clientOnlyMode": false,
      "bridgeTokenManual": "",
      "statusPollIntervalSec": 30,
      "hideWhenIdle": false,
      "launcherPrefix": ">hermes",
      "panelPinned": false,
      "showToolActivity": false,
      "defaultProvider": "",
      "defaultModel": "",
      "configured": false
    }
  }
}
