{
  "id": "translator",
  "name": "Translator",
  "version": "1.2.9",
  "minNoctaliaVersion": "4.4.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "Cleboost",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Quick translate in launcher",
  "tags": [
    "Launcher"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "translate",
    "settingsSchema": {
      "version": 1,
      "fields": {
        "backend": {"type": "String"},
        "deeplApiKey": {"type": "String", "optional": true, "sensitive": true, "machineLocal": true},
        "realTime": {"type": "Boolean"},
        "realTimeTranslation": {"type": "Boolean", "optional": true},
        "showPreview": {"type": "Boolean", "optional": true}
      }
    },
    "defaultSettings": {
      "backend": "google",
      "realTime": true
    }
  }
}
