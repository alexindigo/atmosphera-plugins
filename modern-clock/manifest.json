{
  "id": "modern-clock",
  "name": "Modern Clock",
  "version": "1.0.4",
  "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.10.0",
  "author": "Screamified",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A Modern looking clock desktop widget that will tell you the time. (duh)",
  "tags": ["Desktop", "Fun"],
  "entryPoints": {
    "desktopWidget": "DesktopWidget.qml",
    "desktopWidgetSettings": "DesktopWidgetSettings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "colourChoice": {"type": "Boolean"},
        "customDateFont": {"type": "String"},
        "customDayFont": {"type": "String"},
        "customTimeFont": {"type": "String"},
        "dateColourChoice": {"type": "String"},
        "dateColourPicker": {"type": "String"},
        "dateFontSize": {"type": "Real", "optional": true},
        "dayColourChoice": {"type": "String"},
        "dayColourPicker": {"type": "String"},
        "dayFontSize": {"type": "Real", "optional": true},
        "textOpacity": {"type": "Real"},
        "timeColourChoice": {"type": "String"},
        "timeColourPicker": {"type": "String"},
        "timeFontSize": {"type": "Real", "optional": true}
      }
    },
    "defaultSettings": {
      "dayColourPicker": "black",
      "dateColourPicker": "black",
      "timeColourPicker": "black",
      "dayColourChoice": "primary",
      "dateColourChoice": "secondary",
      "timeColourChoice": "secondary",
      "customDayFont": "",
      "customDateFont": "",
      "customTimeFont": "",
      "textOpacity": 1,
      "colourChoice": true
    }
  }
}
