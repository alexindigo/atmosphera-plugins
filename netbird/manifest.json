{
  "id": "netbird",
  "name": "NetBird",
  "version": "1.1.10",
  "minNoctaliaVersion": "4.0.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "Cleboost",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Show NetBird VPN status in the menu bar.",
  "tags": ["Bar", "Network", "Panel"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "compactMode": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultPeerAction": {"editorUsage": "configuration", "type": "String"},
        "hideDisconnected": {"editorUsage": "configuration", "type": "Boolean"},
        "managementUrl": {"editorUsage": "configuration", "type": "String"},
        "pingCount": {"editorUsage": "configuration", "type": "Real"},
        "refreshInterval": {"editorUsage": "configuration", "type": "Real"},
        "showIpAddress": {"editorUsage": "configuration", "type": "Boolean"},
        "showPing": {"editorUsage": "configuration", "type": "Boolean"},
        "terminalCommand": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "refreshInterval": 5000,
      "compactMode": false,
      "showIpAddress": true,
      "hideDisconnected": false,
      "showPing": false,
      "terminalCommand": "",
      "pingCount": 5,
      "defaultPeerAction": "copy-ip",
      "managementUrl": ""
    }
  }
}
