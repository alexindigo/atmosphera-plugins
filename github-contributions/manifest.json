{
  "id": "github-contributions",
  "name": "GitHub Contributions",
  "version": "1.0.3",
  "minNoctaliaVersion": "4.4.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "xevrion",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Displays your GitHub contribution graph as a desktop widget. Works without a token via your public profile, or with a personal access token for private contributions.",
  "tags": ["Desktop", "Development", "Network"],
  "entryPoints": {
    "main": "Main.qml",
    "desktopWidget": "DesktopWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "layout": {"type": "String"},
        "refreshInterval": {"type": "Real"},
        "showLabels": {"type": "Boolean"},
        "showTotal": {"type": "Boolean"},
        "token": {"type": "String"},
        "username": {"type": "String"},
        "weeksShown": {"type": "Real"}
      }
    },
    "defaultSettings": {
      "username": "",
      "token": "",
      "layout": "graph",
      "weeksShown": 52,
      "refreshInterval": 60,
      "showTotal": true,
      "showLabels": true
    }
  }
}
