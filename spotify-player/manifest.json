{
    "id": "spotify-player",
    "name": "Spotify Player",
    "version": "1.0.4",
    "minNoctaliaVersion": "4.7.6",
    "minAtmospheraVersion": "0.10.0",
    "author": "suvi",
    "license": "GPL 3.0",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "description": "Control spotify_player from a bar widget.",
    "tags": ["Bar", "Panel", "Music"],
    "entryPoints": {
        "barWidget": "BarWidget.qml",
        "panel": "Panel.qml",
        "settings": "Settings.qml",
        "main": "Main.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "settingsSchema": {
            "version": 1,
            "fields": {
                "accessToken": {"type": "String", "machineLocal": true, "sensitive": true},
                "callbackPort": {"type": "Real"},
                "clientId": {"type": "String"},
                "clientSecret": {"type": "String", "machineLocal": true, "sensitive": true},
                "message": {"type": "String", "optional": true},
                "playerId": {"type": "String"},
                "refreshToken": {"type": "String", "machineLocal": true, "sensitive": true},
                "tokenExpiresAt": {"type": "Real", "machineLocal": true}
            }
        },
        "defaultSettings": {
            "clientId": "",
            "clientSecret": "",
            "accessToken": "",
            "refreshToken": "",
            "tokenExpiresAt": 0,
            "playerId": "",
            "callbackPort": 8888
        }
    }
}
