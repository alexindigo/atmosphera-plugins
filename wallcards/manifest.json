{
  "id": "wallcards",
  "name": "Wallcards",
  "version": "0.1.11",
  "minNoctaliaVersion": "4.7.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "tonigineer",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A `lively` wallpaper selector.",
  "tags": ["Desktop", "Theming"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "animate_window": {"editorUsage": "configuration", "type": "Boolean"},
        "animation_cards_duration": {"editorUsage": "configuration", "type": "Real"},
        "animation_duration": {"editorUsage": "configuration", "type": "Real", "optional": true},
        "animation_window_duration": {"editorUsage": "configuration", "type": "Real"},
        "background_color": {"editorUsage": "configuration", "type": "String", "nullable": true},
        "background_opacity": {"editorUsage": "configuration", "type": "Real", "nullable": true},
        "card_height": {"editorUsage": "configuration", "type": "Real"},
        "card_spacing": {"editorUsage": "configuration", "type": "Real"},
        "card_strip_width": {"editorUsage": "configuration", "type": "Real"},
        "cards_shown": {"editorUsage": "configuration", "type": "Real"},
        "center_width_ratio": {"editorUsage": "configuration", "type": "Real"},
        "hide_help": {"editorUsage": "configuration", "type": "Boolean"},
        "hide_top_bar": {"editorUsage": "configuration", "type": "Boolean"},
        "iconColor": {"editorUsage": "configuration", "type": "String", "optional": true},
        "icon_color": {"editorUsage": "configuration", "type": "String", "optional": true},
        "image_filter": {"editorUsage": "configuration", "type": "List", "element": {"type": "String"}},
        "live_preview": {"editorUsage": "configuration", "type": "Boolean"},
        "selected_filter": {"editorUsage": "configuration", "type": "String"},
        "shear_factor": {"editorUsage": "configuration", "type": "Real"},
        "top_bar_height": {"editorUsage": "configuration", "type": "Real"},
        "video_filter": {"editorUsage": "configuration", "type": "List", "element": {"type": "String"}}
      }
    },
    "defaultSettings": {
      "animation_cards_duration": 750,
      "animation_window_duration": 500,
      "animate_window": true,
      "background_color": null,
      "background_opacity": null,
      "card_height": 350,
      "card_spacing": 6,
      "card_strip_width": 90,
      "cards_shown": 11,
      "center_width_ratio": 0.33,
      "image_filter": ["png", "jpg", "jpeg"],
      "video_filter": ["mp4", "avi"],
      "hide_help": false,
      "hide_top_bar": false,
      "live_preview": false,
      "selected_filter": "images",
      "shear_factor": -0.25,
      "top_bar_height": 35
    }
  }
}
