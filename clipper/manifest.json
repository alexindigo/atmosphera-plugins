{
  "id": "clipper",
  "name": "Clipper",
  "version": "2.4.9",
  "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.10.0",
  "author": "blackbartblues",
  "contributors": [
    "rscipher001",
    "neyfua"
  ],
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Advanced clipboard manager with history, search, keyboard navigation, ToDo integration, pinned items, notecards/sticky notes, and selection-to-notecard feature. Fully translated with comprehensive i18n support.",
  "tags": [
    "Utility",
    "Bar",
    "Panel"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoPaste": {"editorUsage": "configuration", "type": "Boolean"},
        "autoPasteDelay": {"editorUsage": "configuration", "type": "Real"},
        "autoPasteOnRightClick": {"editorUsage": "configuration", "type": "Boolean"},
        "cardColors": {"editorUsage": "configuration", "type": "Map","element": {"type": "Record","fields": {"bg": {"type": "String","optional": true},"separator": {"type": "String","optional": true},"fg": {"type": "String","optional": true}}}},
        "customColors": {"editorUsage": "configuration", "type": "Map","element": {"type": "Record","fields": {"bg": {"type": "String","optional": true},"separator": {"type": "String","optional": true},"fg": {"type": "String","optional": true}}}},
        "enableTodoIntegration": {"editorUsage": "configuration", "type": "Boolean"},
        "fullscreenMode": {"editorUsage": "configuration", "type": "Boolean"},
        "hidePanelBackground": {"editorUsage": "configuration", "type": "Boolean"},
        "notecardsEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "panelHeight": {"editorUsage": "configuration", "type": "Real"},
        "panelWidth": {"editorUsage": "configuration", "type": "Real"},
        "pincardsEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "showCloseButton": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "enableTodoIntegration": false,
      "pincardsEnabled": true,
      "notecardsEnabled": true,
      "showCloseButton": true,
      "fullscreenMode": false,
      "hidePanelBackground": false,
      "autoPaste": false,
      "autoPasteOnRightClick": false,
      "autoPasteDelay": 300,
      "panelWidth": 1450,
      "panelHeight": 0,
      "cardColors": {},
      "customColors": {}
    }
  }
}
