{
  "id": "osk-toggle",
  "name": "OSK Toggle",
  "version": "1.0.11",
  "minNoctaliaVersion": "4.4.3",
  "minAtmospheraVersion": "0.11.0",
  "author": "blackteaextract",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Toggle an on-screen keyboard (Squeekboard or wvkbd) with live availability detection, hover icons, and configurable settings. Supersedes squeekboard-toggle.",
  "tags": [
    "System",
    "Bar",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "backend": {"editorUsage": "configuration", "type": "String"},
        "disableHoverIcon": {"editorUsage": "configuration", "type": "Boolean"},
        "hideWhenUnavailable": {"editorUsage": "configuration", "type": "Boolean"},
        "wvkbdBin": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "backend": "auto",
      "hideWhenUnavailable": false,
      "disableHoverIcon": false,
      "wvkbdBin": "wvkbd-mobintl"
    }
  }
}
