{
  "id": "niri-auto-tile",
  "name": "Auto-Tile",
  "version": "1.4.6",
  "minNoctaliaVersion": "4.4.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "pir0c0pter0",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Automatically redistributes niri column widths evenly when windows open or close",
  "tags": ["Bar", "Utility", "System", "Niri"],

  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },

  "dependencies": {
    "plugins": []
  },

  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "debounceMs": {"editorUsage": "configuration", "type": "Real"},
        "enabled": {"editorUsage": "configuration", "type": "Boolean"},
        "language": {"editorUsage": "configuration", "type": "String"},
        "maxEventsPerSecond": {"editorUsage": "configuration", "type": "Real"},
        "maxVisible": {"editorUsage": "configuration", "type": "Real"},
        "onlyAtMax": {"editorUsage": "configuration", "type": "Boolean", "optional": true},
        "perWorkspace": {"editorUsage": "configuration", "type": "Boolean"},
        "workspaceMaxVisible": {"editorUsage": "configuration", "type": "Map", "element": {"type": "Real"}}
      }
    },
    "defaultSettings": {
      "maxVisible": 4,
      "debounceMs": 300,
      "maxEventsPerSecond": 20,
      "enabled": true,
      "perWorkspace": false,
      "workspaceMaxVisible": {},
      "language": "auto"
    }
  }
}
