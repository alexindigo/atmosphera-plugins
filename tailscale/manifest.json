{
  "id": "tailscale",
  "name": "Tailscale",
  "version": "1.5.6",
  "minNoctaliaVersion": "4.0.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "nineluj",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Show Tailscale status in the menu bar and send/receive files via Taildrop.",
  "tags": [
    "Bar",
    "Network",
    "Panel"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "compactMode": {"type": "Boolean"},
        "defaultPeerAction": {"type": "String"},
        "hideDisconnected": {"type": "Boolean"},
        "hideMullvadExitNodes": {"type": "Boolean"},
        "loginServer": {"type": "String"},
        "pingCount": {"type": "Real"},
        "refreshInterval": {"type": "Real"},
        "showIpAddress": {"type": "Boolean"},
        "showPeerCount": {"type": "Boolean"},
        "showSearchBar": {"type": "Boolean"},
        "sshUsername": {"type": "String"},
        "taildropDownloadDir": {"type": "String"},
        "taildropEnabled": {"type": "Boolean"},
        "taildropReceiveMode": {"type": "String"},
        "terminalCommand": {"type": "String"}
      }
    },
    "defaultSettings": {
      "refreshInterval": 5000,
      "compactMode": false,
      "showIpAddress": true,
      "showPeerCount": true,
      "hideDisconnected": false,
      "hideMullvadExitNodes": true,
      "showSearchBar": false,
      "terminalCommand": "",
      "sshUsername": "",
      "pingCount": 5,
      "defaultPeerAction": "copy-ip",
      "taildropEnabled": true,
      "taildropDownloadDir": "~/Downloads",
      "taildropReceiveMode": "operator",
      "loginServer": ""
    }
  }
}
