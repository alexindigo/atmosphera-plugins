{
  "id": "simple-notes",
  "name": "Simple Notes",
  "version": "1.0.10",
  "minNoctaliaVersion": "3.7.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "fusuyfusuy",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A simple note taking plugin for Noctalia Shell.",
  "tags": [
    "Bar",
    "Panel",
    "Productivity"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "count": {"type": "Real", "editorUsage": "operational", "optional": true, "machineLocal": true},
        "notes": {"type": "List", "editorUsage": "content", "machineLocal": true, "element": {"type": "Record", "fields": {"id": {"type": "String", "optional": true}, "title": {"type": "String", "optional": true}, "content": {"type": "String", "optional": true}, "modifiedAt": {"type": "String", "optional": true}}}},
        "showCountInBar": {"type": "Boolean", "editorUsage": "configuration"}
      }
    },
    "defaultSettings": {
      "notes": [],
      "showCountInBar": true
    }
  }
}
