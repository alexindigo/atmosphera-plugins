{
    "id": "file-search",
    "name": "File Search",
  "version": "1.0.12",
    "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.11.0",
    "author": "ericbreh",
    "license": "MIT",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "description": "File search from the launcher.",
    "tags": [
        "Launcher",
        "Productivity"
    ],
    "entryPoints": {
        "main": "Main.qml",
        "launcherProvider": "LauncherProvider.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "settingsSchema": {
          "version": 1,
          "fields": {
            "fdCommand": {"editorUsage": "configuration", "type": "String"},
            "fileOpener": {"editorUsage": "configuration", "type": "String"},
            "maxResults": {"editorUsage": "configuration", "type": "Real"},
            "searchDirectory": {"editorUsage": "configuration", "type": "String"},
            "showHidden": {"editorUsage": "configuration", "type": "Boolean"}
          }
        },
        "defaultSettings": {
            "showHidden": false,
            "maxResults": 100,
            "fileOpener": "xdg-open",
            "searchDirectory": "~",
            "fdCommand": "fd"
        }
    }
}
