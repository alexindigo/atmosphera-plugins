{
  "id": "kubectl-ctx",
  "name": "Kubectl Context",
  "version": "1.0.14",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.11.0",
  "author": "ultherego",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Kubernetes context and namespace switcher with resource browser powered by kubectl.",
  "tags": ["Bar", "Panel", "Utility", "Development"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "kubeconfigPath": {"editorUsage": "configuration", "type": "String"},
        "panelHeight": {"editorUsage": "configuration", "type": "Real"},
        "panelWidth": {"editorUsage": "configuration", "type": "Real"},
        "pollInterval": {"editorUsage": "configuration", "type": "Real"},
        "showErrorBadge": {"editorUsage": "configuration", "type": "Boolean"},
        "terminal": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "kubeconfigPath": "",
      "pollInterval": 60,
      "showErrorBadge": true,
      "iconColor": "none",
      "terminal": "",
      "panelWidth": 620,
      "panelHeight": 680
    }
  }
}
