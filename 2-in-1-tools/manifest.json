{
  "id": "2-in-1-tools",
  "name": "2-in-1-tools",
  "version": "1.2.5",
  "minNoctaliaVersion": "4.4.3",
  "minAtmospheraVersion": "0.10.0",
  "author": "Codex",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A Noctalia utility plugin for screen rotation tools on Niri and Hyprland.",
  "tags": [
    "Bar",
    "Control Center",
    "System",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoRotateInTabletMode": {"type": "Boolean"},
        "autoRotateOutsideTabletMode": {"type": "Boolean"},
        "autoTabletBarDensity": {"type": "Boolean"},
        "buttonBehavior": {"type": "String"},
        "exclusiveDockInTabletMode": {"type": "Boolean"},
        "flipVerticalSensorOrientation": {"type": "Boolean"},
        "iconName": {"type": "String"},
        "lastNonTabletBarDensity": {"type": "String", "machineLocal": true},
        "lastNonTabletDockEnabled": {"type": "Boolean", "machineLocal": true},
        "lastNonTabletDockType": {"type": "String", "machineLocal": true},
        "showSuccessToast": {"type": "Boolean"},
        "showTransformInTooltip": {"type": "Boolean"},
        "syncHyprTouchTransform": {"type": "Boolean"},
        "tabletBarDensity": {"type": "String"},
        "tabletModeStateFile": {"type": "String"}
      }
    },
    "defaultSettings": {
      "iconName": "rotate-cw",
      "showTransformInTooltip": true,
      "showSuccessToast": true,
      "autoTabletBarDensity": false,
      "exclusiveDockInTabletMode": false,
      "autoRotateInTabletMode": false,
      "autoRotateOutsideTabletMode": false,
      "syncHyprTouchTransform": true,
      "flipVerticalSensorOrientation": false,
      "buttonBehavior": "toggle-auto-rotate-lock",
      "tabletBarDensity": "default",
      "tabletModeStateFile": "/tmp/noctalia-tablet-mode",
      "lastNonTabletBarDensity": "",
      "lastNonTabletDockType": "",
      "lastNonTabletDockEnabled": true
    }
  }
}
