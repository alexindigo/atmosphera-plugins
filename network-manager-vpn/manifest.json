{
  "id": "network-manager-vpn",
  "name": "Network Manager VPN",
  "version": "1.3.8",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "nZO",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Connect to VPN via NetworkManager",
  "tags": [
    "Bar",
    "Panel",
    "Network"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "connectedColor": {"editorUsage": "configuration", "type": "String"},
        "disableToastNotifications": {"editorUsage": "configuration", "type": "Boolean"},
        "disconnectedColor": {"editorUsage": "configuration", "type": "String"},
        "displayMode": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "displayMode": "onhover",
      "disconnectedColor": "none",
      "connectedColor": "primary",
      "disableToastNotifications": false
    }
  }
}
