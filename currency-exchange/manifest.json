{
  "id": "currency-exchange",
  "name": "Currency Exchange",
  "version": "1.0.12",
  "description": "Currency conversion utility via launcher and bar widget",
  "tags": [
    "Launcher",
    "Utility"
  ],
  "minNoctaliaVersion": "4.4.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "balor",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "entryPoints": {
    "main": "Main.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "fx",
    "settingsSchema": {
      "version": 1,
      "fields": {
        "refreshInterval": {"editorUsage": "configuration", "type": "Real"},
        "sourceCurrency": {"editorUsage": "configuration", "type": "String"},
        "targetCurrency": {"editorUsage": "configuration", "type": "String"},
        "widgetDisplayMode": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "sourceCurrency": "USD",
      "targetCurrency": "EUR",
      "widgetDisplayMode": "icon",
      "refreshInterval": 60
    }
  }
}
