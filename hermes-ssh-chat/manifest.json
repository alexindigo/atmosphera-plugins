{
  "id": "hermes-ssh-chat",
  "name": "Hermes SSH Terminal",
  "version": "1.0.9",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.10.0",
  "author": "focky",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Use Hermes on a remote server through an interactive SSH terminal.",
  "tags": [
    "Bar",
    "Panel",
    "Development",
    "AI"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "cpuIntensive": false,
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoConnectOnStartup": {"editorUsage": "configuration", "type": "Boolean"},
        "host": {"editorUsage": "configuration", "type": "String", "machineLocal": true},
        "panelHeight": {"editorUsage": "configuration", "type": "Real"},
        "panelWidth": {"editorUsage": "configuration", "type": "Real"},
        "port": {"editorUsage": "configuration", "type": "Real", "machineLocal": true},
        "rememberLastTarget": {"editorUsage": "configuration", "type": "Boolean"},
        "showBarText": {"editorUsage": "configuration", "type": "Boolean"},
        "terminalCols": {"editorUsage": "configuration", "type": "Real"},
        "terminalFontSize": {"editorUsage": "configuration", "type": "Real"},
        "terminalRows": {"editorUsage": "configuration", "type": "Real"},
        "toggleShortcutName": {"editorUsage": "configuration", "type": "String"},
        "user": {"editorUsage": "configuration", "type": "String", "machineLocal": true}
      }
    },
    "defaultSettings": {
      "host": "",
      "port": 22,
      "user": "",
      "rememberLastTarget": true,
      "autoConnectOnStartup": false,
      "toggleShortcutName": "hermes-toggle",
      "panelWidth": 1200,
      "panelHeight": 760,
      "terminalCols": 180,
      "terminalRows": 32,
      "terminalFontSize": 11,
      "showBarText": true
    }
  }
}
