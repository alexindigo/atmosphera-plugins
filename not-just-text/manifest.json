{
  "id": "not-just-text",
  "name": "Not Just Text",
  "version": "1.0.7",
  "minNoctaliaVersion": "4.4.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "blackteaextract",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Displays custom text, fortune quotes, or a random entry from a user-provided text file in the bar.",
  "tags": [
    "Bar",
    "Fun"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "fortuneCategory": {"editorUsage": "configuration", "type": "String"},
        "fortuneEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "fortuneEqual": {"editorUsage": "configuration", "type": "Boolean"},
        "fortuneMaxLength": {"editorUsage": "configuration", "type": "Real"},
        "fortuneOffensive": {"editorUsage": "configuration", "type": "Boolean"},
        "listEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "refreshOnWallpaper": {"editorUsage": "configuration", "type": "Boolean"},
        "text": {"editorUsage": "configuration", "type": "String"},
        "textFile": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "text": "Hello",
      "fortuneEnabled": false,
      "fortuneOffensive": false,
      "fortuneEqual": false,
      "fortuneCategory": "",
      "fortuneMaxLength": 60,
      "listEnabled": false,
      "textFile": "",
      "refreshOnWallpaper": true
    }
  }
}
