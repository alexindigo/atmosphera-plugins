{
    "id": "custom-battery",
    "name": "Custom Battery",
    "version": "1.0.2",
    "minNoctaliaVersion": "4.0.0",
    "minAtmospheraVersion": "0.8.0",
    "author": "ronin ck",
    "license": "MIT",

    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "description": "A custom battery icon.",
    "tags": [
        "Bar",
        "System"
    ],
    "entryPoints": {
        "main": "Main.qml",
        "barWidget": "BarWidget.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "settingsSchema": {
            "version": 1,
            "fields": {
                "deviceNativePath": {"type": "String", "optional": true},
                "displayMode": {"type": "String", "optional": true},
                "hideIfIdle": {"type": "Boolean", "optional": true},
                "hideIfNotDetected": {"type": "Boolean", "optional": true},
                "iconScale": {"type": "Real", "optional": true}
            }
        },
        "defaultSettings": {}
    }
}