{
  "id": "clipboard",
  "name": "Clipboard",
  "version": "1.0.10",
  "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.10.0",
  "author": "yanekyuk",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "license": "MIT",
  "description": "Clipboard history panel with search, pinning, and image previews.",
  "tags": [
    "Utility",
    "Bar",
    "Panel"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "actions": [
    {"id": "toggle", "label": "Clipboard panel", "description": "Toggle the clipboard plugin panel.", "icon": "clipboard", "command": "atmosphera ipc plugin:clipboard toggle"},
    {"id": "wipe", "label": "Clear clipboard history", "description": "Clear clipboard history. Pinned entries are kept.", "icon": "trash", "command": "atmosphera ipc plugin:clipboard wipe"}
  ],
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "density": {"editorUsage": "configuration", "type": "String"},
        "maxHistorySize": {"editorUsage": "configuration", "type": "Real"},
        "showImagePreviews": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "maxHistorySize": 100,
      "showImagePreviews": true,
      "density": "comfortable"
    }
  }
}
