{
  "id": "special-workspaces",
  "name": "Special Workspaces (Hyprland)",
  "version": "1.1.7",
  "minNoctaliaVersion": "4.4.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Qholin",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Configurable Hyprland special workspaces indicator for the bar.",
  "tags": ["Bar", "Productivity", "Hyprland"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "drawer": {"editorUsage": "configuration", "type": "Boolean"},
        "expandDirection": {"editorUsage": "configuration", "type": "String"},
        "hideEmptyWorkspaces": {"editorUsage": "configuration", "type": "Boolean"},
        "mainIcon": {"editorUsage": "configuration", "type": "String"},
        "panelBackgroundColor": {"editorUsage": "configuration", "type": "String"},
        "panelBackgroundEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "primaryBorderRadius": {"editorUsage": "configuration", "type": "Real"},
        "primaryFocusColor": {"editorUsage": "configuration", "type": "String"},
        "primaryPillColor": {"editorUsage": "configuration", "type": "String"},
        "primaryShowPill": {"editorUsage": "configuration", "type": "Boolean"},
        "primarySize": {"editorUsage": "configuration", "type": "Real"},
        "primarySymbolColor": {"editorUsage": "configuration", "type": "String"},
        "workspaces": {"editorUsage": "configuration", "type": "List", "element": {"type": "Record", "fields": {"name": {"type": "String"}, "icon": {"type": "String", "optional": true}, "symbolColor": {"type": "String", "optional": true}, "showPill": {"type": "Boolean", "optional": true}, "pillColor": {"type": "String", "optional": true}, "size": {"type": "Real", "optional": true}, "borderRadius": {"type": "Real", "optional": true}, "focusColor": {"type": "String", "optional": true}}}}
      }
    },
    "defaultSettings": {
      "mainIcon": "layout-grid",
      "expandDirection": "up",
      "primarySymbolColor": "none",
      "primaryShowPill": true,
      "primaryPillColor": "none",
      "primarySize": 0.9,
      "primaryBorderRadius": 1.0,
      "primaryFocusColor": "primary",
      "panelBackgroundColor": "none",
      "panelBackgroundEnabled": false,
      "workspaces": [
        {
          "name": "communication",
          "icon": "message",
          "symbolColor": "none",
          "showPill": true,
          "pillColor": "primary",
          "size": 0.9,
          "borderRadius": 1.0,
          "focusColor": "primary"
        },
        {
          "name": "music",
          "icon": "music",
          "symbolColor": "none",
          "showPill": true,
          "pillColor": "primary",
          "size": 0.9,
          "borderRadius": 1.0,
          "focusColor": "primary"
        },
        {
          "name": "agent",
          "icon": "michelin-star",
          "symbolColor": "none",
          "showPill": true,
          "pillColor": "primary",
          "size": 0.9,
          "borderRadius": 1.0,
          "focusColor": "primary"
        }
      ],
      "drawer": true,
      "hideEmptyWorkspaces": false
    }
  }
}
