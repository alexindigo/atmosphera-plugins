{
    "id": "vscode-provider",
    "name": "VS Code Provider",
    "version": "1.0.4",
    "minAtmospheraVersion": "0.10.0",
    "description": "Open VS Code Folders and Workspaces",
    "tags": ["Launcher", "Development"],
    "minNoctaliaVersion": "4.5.0",
    "author": "Krendil",
    "license": "MIT",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "entryPoints": {
        "main": "Main.qml",
        "launcherProvider": "LauncherProvider.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "commandPrefix": "vsc",
        "settingsSchema": {
          "version": 1,
          "fields": {
            "command": {"type": "String"},
            "configName": {"type": "String"},
            "includeInSearch": {"type": "Boolean"}
          }
        },
        "defaultSettings": {
            "command": "code",
            "configName": "Code",
            "includeInSearch": true
        }
    }
}
