{
  "id": "ideapad-battery-health",
  "name": "Ideapad Battery Health",
  "version": "1.0.3",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.8.0",
  "author": "Christophe Branchereau",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Set the battery charging mode for ideapad laptop batteries, to extend battery lifespan",
  "tags": [
    "Bar",
    "Panel",
    "System"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "iconColor": {"type": "String","optional": true},
        "preservationMode": {"type": "Real"}
      }
    },
    "defaultSettings": {
      "preservationMode": 0
    }
  }
}
