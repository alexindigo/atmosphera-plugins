{
	"id": "noctalia-supergfxctl",
	"name": "SuperGFX Control",
	"version": "0.0.6",
	"minNoctaliaVersion": "3.8.2",
	"minAtmospheraVersion": "0.10.0",
	"author": "cod3d <cod3ddot@proton.me>",
	"license": "MIT",
	"repository": "https://github.com/noctalia-dev/noctalia-plugins",
	"description": "GPU control with supergfxctl for noctalia.",
	"tags": ["Bar", "Panel", "System"],
	"entryPoints": {
		"main": "src/Main.qml",
		"barWidget": "src/Bar.qml",
		"controlCenterWidget": "src/ControlCenter.qml",
		"settings": "src/Settings.qml",
		"panel": "src/Panel.qml"
	},
	"dependencies": {
		"plugins": []
	},
	"metadata": {
		"settingsSchema": {
			"version": 1,
			"fields": {
				"debug": {"type": "Boolean"},
				"rogcc": {"type": "Record", "fields": {"listenToNotifications": {"type": "Boolean", "optional": true}}},
				"supergfxctl": {"type": "Record", "fields": {"patchPending": {"type": "Boolean", "optional": true}, "polling": {"type": "Boolean", "optional": true}, "pollingInterval": {"type": "Real", "optional": true}}}
			}
		},
		"defaultSettings": {
			"debug": false,
			"supergfxctl": {
				"patchPending": true,
				"polling": false,
				"pollingInterval": 3000
			},
			"rogcc": {
				"listenToNotifications": false
			}
		}
	}
}
