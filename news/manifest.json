{
  "id": "news",
  "name": "News Bar",
  "version": "1.2.12",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "LazarH",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Display scrolling news headlines from various sources using NewsAPI.org",
  "tags": [
    "Bar",
    "Panel",
    "Network",
    "Fun"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "apiKey": {"editorUsage": "configuration", "type": "String"},
        "category": {"editorUsage": "configuration", "type": "String"},
        "country": {"editorUsage": "configuration", "type": "String"},
        "language": {"editorUsage": "configuration", "type": "String"},
        "maxHeadlines": {"editorUsage": "configuration", "type": "Real"},
        "refreshInterval": {"editorUsage": "configuration", "type": "Real"},
        "rollingSpeed": {"editorUsage": "configuration", "type": "Real"},
        "widgetWidth": {"editorUsage": "configuration", "type": "Real"}
      }
    },
    "defaultSettings": {
      "apiKey": "YOUR_API_KEY_HERE",
      "country": "us",
      "language": "en",
      "category": "general",
      "refreshInterval": 30,
      "maxHeadlines": 10,
      "rollingSpeed": 50,
      "widgetWidth": 300
    }
  }
}
