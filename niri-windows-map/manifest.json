{
  "id": "niri-windows-map",
  "name": "Niri Windows Map",
  "version": "1.0.4",
  "author": "Atmosphera",
  "license": "GPL-3.0",
  "description": "Spatial overview map of niri windows \u2014 workspaces as rows, columns and tiles laid out like niri's scrolling layout. Click a tile to focus it, click a row to switch workspace.",
  "minAtmospheraVersion": "0.10.0",
  "defaultEnabled": false,
  "tags": [
    "Panel",
    "Niri",
    "Overview",
    "Built-in"
  ],
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "audioIndicators": {"type": "Boolean"},
        "browserIcons": {"type": "Boolean"},
        "corner": {"type": "String"},
        "hideIcons": {"type": "Boolean"},
        "hideOnClick": {"type": "Boolean"},
        "hoverInfo": {"type": "Boolean"},
        "panelSize": {"type": "String"},
        "terminalIcons": {"type": "Boolean"}
      }
    },
    "defaultSettings": {
      "panelSize": "regular",
      "corner": "bottomRight",
      "hideIcons": false,
      "hideOnClick": false,
      "terminalIcons": true,
      "browserIcons": true,
      "audioIndicators": true,
      "hoverInfo": true
    }
  }
}
