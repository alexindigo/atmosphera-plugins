{
  "id": "niri-windows-map",
  "name": "Niri Windows Map",
  "version": "1.0.20",
  "author": "Atmosphera",
  "license": "GPL-3.0",
  "description": "Spatial overview map of niri windows and workspaces. Click tiles to focus, click rows to switch, or drag a window to move it.",
  "minAtmospheraVersion": "0.12.0",
  "defaultEnabled": false,
  "tags": [
    "Panel",
    "Niri",
    "Overview",
    "Built-in"
  ],
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "audioIndicators": {"editorUsage": "configuration", "type": "Boolean"},
        "browserIcons": {"editorUsage": "configuration", "type": "Boolean"},
        "corner": {"editorUsage": "configuration", "type": "String"},
        "hideIcons": {"editorUsage": "configuration", "type": "Boolean"},
        "hideOnClick": {"editorUsage": "configuration", "type": "Boolean"},
        "hoverInfo": {"editorUsage": "configuration", "type": "Boolean"},
        "panelSize": {"editorUsage": "configuration", "type": "String"},
        "terminalIcons": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "panelSize": "regular",
      "corner": "bottomRight",
      "hideIcons": false,
      "hideOnClick": false,
      "terminalIcons": true,
      "browserIcons": true,
      "audioIndicators": true,
      "hoverInfo": true
    }
  }
}
