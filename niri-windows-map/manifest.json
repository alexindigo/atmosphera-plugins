{
  "id": "niri-windows-map",
  "name": "Niri Windows Map",
  "version": "1.0.5",
  "author": "Atmosphera",
  "license": "GPL-3.0",
  "description": "Spatial overview map of niri windows: workspaces, columns and tiles. Click tiles to focus and rows to switch workspace. Reliable startup focus and drag require the stale-seed shell fix in Atmosphera PR #29.",
  "minAtmospheraVersion": "0.9.0",
  "defaultEnabled": false,
  "tags": [
    "Panel",
    "Niri",
    "Overview",
    "Built-in"
  ],
  "entryPoints": {
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "defaultSettings": {
      "panelSize": "regular",
      "corner": "bottomRight",
      "hideIcons": false,
      "hideOnClick": false,
      "terminalIcons": true,
      "browserIcons": true,
      "audioIndicators": true,
      "hoverInfo": true
    }
  }
}
