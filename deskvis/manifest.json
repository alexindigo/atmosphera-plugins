{
  "id": "deskvis",
  "name": "DeskVis",
  "version": "2.0.4",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.8.0",
  "author": "HAVEKziad",
  "license": "MIT",
  "description": "Audio visualizer desktop widget — bars, wave, or mirror. Supports all directions. Transparent, follows color scheme.",
  "tags": [
    "Desktop",
    "Audio"
  ],
  "entryPoints": {
    "desktopWidget": "DesktopWidget.qml",
    "desktopWidgetSettings": "DesktopWidgetSettings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "barCount": {"type": "Real"},
        "customHeight": {"type": "Real"},
        "customPrimaryColor": {"type": "String"},
        "customSecondaryColor": {"type": "String"},
        "customWidth": {"type": "Real"},
        "direction": {"type": "String"},
        "fadeWhenIdle": {"type": "Boolean"},
        "fps": {"type": "Real"},
        "mode": {"type": "String"},
        "sensitivity": {"type": "Real"},
        "smoothing": {"type": "Real"},
        "useCustomColors": {"type": "Boolean"},
        "useGradient": {"type": "Boolean"}
      }
    },
    "defaultSettings": {
      "direction": "up",
      "mode": "bars",
      "barCount": 32,
      "fps": 60,
      "sensitivity": 1.5,
      "smoothing": 0.18,
      "useGradient": true,
      "fadeWhenIdle": true,
      "useCustomColors": false,
      "customPrimaryColor": "#6750A4",
      "customSecondaryColor": "#625B71",
      "customWidth": 0,
      "customHeight": 0
    }
  }
}
