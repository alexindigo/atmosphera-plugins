{
  "id": "mpvpaper",
  "name": "Mpvpaper",
  "version": "1.6.19",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.12.0",
  "author": "spiros132",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A plugin that allows having video wallpapers using mpvpaper.",
  "tags": [
    "Bar",
    "Panel",
    "Fun",
    "System"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "active": {"editorUsage": "configuration", "type": "Boolean", "optional": true},
        "automation": {"editorUsage": "configuration", "type": "Boolean", "optional": true},
        "automationMode": {"editorUsage": "configuration", "type": "String", "optional": true},
        "automationTime": {"editorUsage": "configuration", "type": "Real", "optional": true},
        "currentWallpaper": {"editorUsage": "configuration", "type": "String", "optional": true},
        "fillMode": {"editorUsage": "configuration", "type": "String"},
        "hardwareAcceleration": {"editorUsage": "configuration", "type": "Boolean", "optional": true},
        "isMuted": {"editorUsage": "configuration", "type": "Boolean", "optional": true},
        "isPlaying": {"editorUsage": "configuration", "type": "Boolean", "optional": true},
        "mpvSocket": {"editorUsage": "configuration", "type": "String"},
        "oldWallpapers": {"editorUsage": "operational", "type": "Map", "optional": true, "machineLocal": true, "element": {"type": "String"}},
        "profile": {"editorUsage": "configuration", "type": "String"},
        "thumbCacheReady": {"editorUsage": "operational", "type": "Boolean", "optional": true, "machineLocal": true},
        "volume": {"editorUsage": "configuration", "type": "Real", "optional": true},
        "wallpapersFolder": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "mpvSocket": "/tmp/mpv-socket",
      "wallpapersFolder": "~/Pictures/Wallpapers",
      "profile": "default",
      "fillMode": "fit"
    }
  }
}
