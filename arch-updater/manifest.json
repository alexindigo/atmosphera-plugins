{
  "id": "arch-updater",
  "name": "Arch Updater",
  "version": "2.1.18",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "Ast",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A plugin to manage updates on Arch",
  "tags": ["Bar", "Desktop", "Panel", "Launcher", "System", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "launcherProvider": "LauncherProvider.qml",    
    "controlCenterWidget": "ControlCenterWidget.qml",
    "desktopWidget": "DesktopWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "aurCmd": {"type": "String", "editorUsage": "configuration"},
        "aurHomepageCmd": {"type": "String", "editorUsage": "configuration"},
        "boldText": {"type": "Boolean", "editorUsage": "configuration"},
        "boldVer": {"type": "Boolean", "editorUsage": "configuration"},
        "boldVerDesktop": {"type": "Boolean", "editorUsage": "configuration"},
        "boldVerPanel": {"type": "Boolean", "editorUsage": "configuration"},
        "closeButton": {"type": "Boolean", "editorUsage": "configuration"},
        "closeOnSettings": {"type": "Boolean", "editorUsage": "configuration"},
        "customIconPath": {"type": "String", "editorUsage": "configuration"},
        "desktopTip": {"type": "Boolean", "editorUsage": "configuration"},
        "enableColorization": {"type": "Boolean", "editorUsage": "configuration"},
        "flatpak": {"type": "Boolean", "editorUsage": "configuration"},
        "hideOnEmpty": {"type": "Boolean", "editorUsage": "configuration"},
        "hoverTip": {"type": "Boolean", "editorUsage": "configuration"},
        "iconColor": {"type": "String", "editorUsage": "configuration"},
        "iconName": {"type": "String", "editorUsage": "configuration"},
        "noctalia": {"type": "Boolean", "editorUsage": "configuration"},
        "panelContext": {"type": "Boolean", "editorUsage": "configuration"},
        "panelTooltip": {"type": "Boolean", "editorUsage": "configuration"},
        "refreshInterval": {"type": "Real", "editorUsage": "configuration"},
        "refreshTimer": {"type": "Boolean", "editorUsage": "configuration"},
        "systemCmd": {"type": "String", "editorUsage": "configuration"},
        "toast": {"type": "Boolean", "editorUsage": "configuration"},
        "tooltip": {"type": "Boolean", "editorUsage": "configuration"},
        "updateCmd": {"type": "String", "editorUsage": "configuration"},
        "useDistroLogo": {"type": "Boolean", "editorUsage": "configuration"}
      }
    },
    "defaultSettings": {
      "systemCmd": "checkupdates 2>/dev/null",
      "aurCmd": "paru -Qua 2>/dev/null",
      "updateCmd": "ghostty -e bash -c 'echo \"Updating System...\";paru; flatpak update; read -n 1 -p \"Press any key to exit...\"'",
      "aurHomepageCmd": "LC_ALL=C paru -Si {id} 2>/dev/null | awk '/^URL/ {print $3}'",
      "flatpak": true,
      "noctalia": true,
      "toast": true,
      "desktopTip": true,
      "hideOnEmpty": false,
      "refreshTimer": true,
      "refreshInterval": 120,
      "iconName": "arrow-big-down-lines",
      "useDistroLogo": false,
      "customIconPath": "",
      "boldText": true,
      "enableColorization": false,
      "iconColor": "none",
      "boldVer": true,
      "tooltip": true,
      "closeButton": true,
      "closeOnSettings": false,
      "panelTooltip": true,
      "panelContext": true,
      "boldVerPanel": true,
      "boldVerDesktop": true,
      "hoverTip": true
    }
  }
}
