{
  "id": "wallpaper-carousel",
  "name": "Wallpaper Carousel",
  "version": "0.8.3",
  "minAtmospheraVersion": "0.10.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "yngwe",
  "license": "MIT",
  "description": "Browse and pick wallpapers with a fullscreen skewed carousel overlay",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "tags": [
    "Theming",
    "Wallpaper"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "borderWidth": {"type": "Real"},
        "carouselMode": {"type": "String"},
        "cornerRadius": {"type": "Real"},
        "enableHoldExpand": {"type": "String"},
        "expandMultiplier": {"type": "Real"},
        "expandSelected": {"type": "String"},
        "holdDelay": {"type": "Real"},
        "holdExpandRatio": {"type": "Real"},
        "itemHeight": {"type": "Real"},
        "itemWidth": {"type": "Real"},
        "overlayOpacity": {"type": "Real"},
        "selectedScale": {"type": "Real"},
        "wallpaperDirectory": {"type": "String"}
      }
    },
    "defaultSettings": {
      "wallpaperDirectory": "",
      "carouselMode": "wrap",
      "overlayOpacity": 80,
      "cornerRadius": 0,
      "itemWidth": 300,
      "itemHeight": 420,
      "borderWidth": 3,
      "expandSelected": "false",
      "selectedScale": 108,
      "expandMultiplier": 120,
      "enableHoldExpand": "false",
      "holdExpandRatio": 35,
      "holdDelay": 1500
    }
  }
}
