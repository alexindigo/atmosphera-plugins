{
  "id": "weather-indicator",
  "name": "Weather Indicator",
  "version": "1.1.13",
  "minNoctaliaVersion": "4.6.8",
  "minAtmospheraVersion": "0.11.0",
  "author": "Sovereign",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Shows the current weather condition and temperature.",
  "tags": ["Bar"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "customColor": {"editorUsage": "configuration", "type": "String"},
        "showConditionIcon": {"editorUsage": "configuration", "type": "Boolean"},
        "showTempUnit": {"editorUsage": "configuration", "type": "Boolean"},
        "showTempValue": {"editorUsage": "configuration", "type": "Boolean"},
        "tooltipOption": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "showTempValue": true,
      "showTempUnit": true,
      "showConditionIcon": true,
      "tooltipOption": "everything",
      "customColor": "none"
    }
  }
}
