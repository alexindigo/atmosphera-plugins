{
  "id": "screen-recorder",
  "name": "Screen Recorder",
  "version": "1.3.16",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "Noctalia Team",
  "official": true,
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Hardware-accelerated screen recording using gpu-screen-recorder with customizable video and audio settings",
  "tags": [
    "Bar",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "audioCodec": {"editorUsage": "configuration", "type": "String"},
        "audioSource": {"editorUsage": "configuration", "type": "String"},
        "colorRange": {"editorUsage": "configuration", "type": "String"},
        "copyToClipboard": {"editorUsage": "configuration", "type": "Boolean"},
        "customFrameRate": {"editorUsage": "configuration", "type": "String", "optional": true},
        "customReplayDuration": {"editorUsage": "configuration", "type": "String"},
        "directory": {"editorUsage": "configuration", "type": "String"},
        "filenamePattern": {"editorUsage": "configuration", "type": "String"},
        "frameRate": {"editorUsage": "configuration", "type": "String"},
        "hideInactive": {"editorUsage": "configuration", "type": "Boolean"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "quality": {"editorUsage": "configuration", "type": "String"},
        "replayDuration": {"editorUsage": "configuration", "type": "String"},
        "replayEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "replayStorage": {"editorUsage": "configuration", "type": "String"},
        "resolution": {"editorUsage": "configuration", "type": "String"},
        "restorePortalSession": {"editorUsage": "configuration", "type": "Boolean"},
        "showCursor": {"editorUsage": "configuration", "type": "Boolean"},
        "videoCodec": {"editorUsage": "configuration", "type": "String"},
        "videoSource": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "hideInactive": false,
      "iconColor": "none",
      "directory": "",
      "filenamePattern": "recording_yyyyMMdd_HHmmss",
      "frameRate": "60",
      "audioCodec": "opus",
      "videoCodec": "h264",
      "quality": "very_high",
      "colorRange": "limited",
      "showCursor": true,
      "copyToClipboard": false,
      "audioSource": "default_output",
      "videoSource": "portal",
      "resolution": "original",
      "replayEnabled": false,
      "replayDuration": "30",
      "customReplayDuration": "30",
      "replayStorage": "ram",
      "restorePortalSession": false
    }
  }
}
