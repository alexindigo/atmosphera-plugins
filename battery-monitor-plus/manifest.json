{
  "id": "battery-monitor-plus",
  "name": "Battery Monitor Plus",
  "version": "1.0.5",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.10.0",
  "author": "krteke",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Extended battery monitor with current power draw, remaining time, battery health, and current power profile.",
  "tags": ["Bar", "Panel", "Indicator", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "deviceNativePath": {"type": "String"},
        "displayMode": {"type": "String"},
        "hideIfIdle": {"type": "Boolean"},
        "hideIfNotDetected": {"type": "Boolean"},
        "refreshIntervalSeconds": {"type": "Real"},
        "showNoctaliaPerformance": {"type": "Boolean"},
        "showPowerInBar": {"type": "Boolean"},
        "showPowerProfiles": {"type": "Boolean"},
        "showTimeInBar": {"type": "Boolean"}
      }
    },
    "defaultSettings": {
      "displayMode": "graphic-clean",
      "deviceNativePath": "__default__",
      "showPowerProfiles": false,
      "showNoctaliaPerformance": false,
      "hideIfNotDetected": true,
      "hideIfIdle": false,
      "refreshIntervalSeconds": 5,
      "showPowerInBar": true,
      "showTimeInBar": true
    }
  }
}
