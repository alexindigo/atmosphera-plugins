{
  "id": "weekly-calendar",
  "name": "Weekly Calendar",
  "version": "1.1.3",
  "minNoctaliaVersion": "4.2.3",
  "minAtmospheraVersion": "0.10.0",
  "author": "dodaars",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A weekly calendar plugin complementing Noctalia's inbuilt calendar service.",
  "tags": ["Bar", "Panel", "Productivity"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "dayLineOpacity": {"type": "Real", "optional": true},
        "hourLineOpacity": {"type": "Real", "optional": true},
        "lineColorType": {"type": "String", "optional": true},
        "panelMode": {"type": "String", "optional": true},
        "timeFormat": {"type": "String", "optional": true},
        "weekStart": {"type": "String", "optional": true}
      }
    }
  }
}
