{
  "id": "linux-wallpaperengine-controller",
  "name": "Linux WallpaperEngine Controller",
  "version": "1.3.7",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.10.0",
  "author": "PaloMiku",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Control linux-wallpaperengine from Noctalia with per-screen wallpaper selection.",
  "tags": [
    "Bar",
    "Panel",
    "Theming"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "applyWallpaperColorsOnApply": {"editorUsage": "configuration", "type": "Boolean"},
        "autoApplyOnStartup": {"editorUsage": "configuration", "type": "Boolean"},
        "badgeEnabled": {"editorUsage": "configuration", "type": "Map","element": {"type": "Boolean"}},
        "badgeOrder": {"editorUsage": "configuration", "type": "List","element": {"type": "String"}},
        "defaultAudioReactiveEffects": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultClamp": {"editorUsage": "configuration", "type": "String"},
        "defaultDisableMouse": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultDisableParallax": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultFps": {"editorUsage": "configuration", "type": "Real"},
        "defaultFullscreenPauseOnlyActive": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultMuted": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultNoAutomute": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultNoFullscreenPause": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultScaling": {"editorUsage": "configuration", "type": "String"},
        "defaultVolume": {"editorUsage": "configuration", "type": "Real"},
        "enableExtraPropertiesEditor": {"editorUsage": "configuration", "type": "Boolean"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "lastKnownGoodScreens": {"editorUsage": "operational", "type": "Map", "machineLocal": true, "element": {"type": "Record","fields": {"path": {"type": "String","optional": true},"scaling": {"type": "String","optional": true},"clamp": {"type": "String","optional": true},"volume": {"type": "Real","optional": true},"muted": {"type": "Boolean","optional": true},"audioReactiveEffects": {"type": "Boolean","optional": true},"noAutomute": {"type": "Boolean","optional": true},"disableMouse": {"type": "Boolean","optional": true},"disableParallax": {"type": "Boolean","optional": true}}}},
        "panelLastSelectedPath": {"editorUsage": "operational", "type": "String", "machineLocal": true},
        "panelPageSize": {"editorUsage": "configuration", "type": "Real"},
        "runtimeRecoveryPending": {"editorUsage": "operational", "type": "Boolean", "machineLocal": true},
        "screens": {"editorUsage": "operational", "type": "Map","element": {"type": "Record","fields": {"path": {"type": "String","optional": true},"scaling": {"type": "String","optional": true},"clamp": {"type": "String","optional": true},"volume": {"type": "Real","optional": true},"muted": {"type": "Boolean","optional": true},"audioReactiveEffects": {"type": "Boolean","optional": true},"noAutomute": {"type": "Boolean","optional": true},"disableMouse": {"type": "Boolean","optional": true},"disableParallax": {"type": "Boolean","optional": true}}}},
        "showSidebarDescription": {"editorUsage": "configuration", "type": "Boolean"},
        "wallpaperColorScreenshots": {"editorUsage": "operational", "type": "Map", "machineLocal": true, "element": {"type": "Record","fields": {"path": {"type": "String","optional": true},"wallpaperPath": {"type": "String","optional": true},"scaling": {"type": "String","optional": true},"updatedAt": {"type": "Real","optional": true}}}},
        "wallpaperProperties": {"editorUsage": "content", "type": "Map","element": {"type": "Map","element": {"type": "String"}}},
        "wallpaperScanCacheMinutes": {"editorUsage": "configuration", "type": "Real"},
        "wallpapersFolder": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "wallpapersFolder": "~/.local/share/Steam/steamapps/workshop/content/431960",
      "iconColor": "none",
      "enableExtraPropertiesEditor": true,
      "defaultScaling": "fill",
      "defaultClamp": "clamp",
      "defaultFps": 30,
      "defaultVolume": 100,
      "defaultMuted": true,
      "defaultAudioReactiveEffects": true,
      "defaultNoAutomute": false,
      "defaultDisableMouse": false,
      "defaultDisableParallax": false,
      "applyWallpaperColorsOnApply": false,
      "wallpaperColorScreenshots": {},
      "defaultNoFullscreenPause": false,
      "defaultFullscreenPauseOnlyActive": false,
      "showSidebarDescription": false,
      "badgeOrder": [
        "type",
        "dynamic",
        "music",
        "reactive",
        "approved",
        "resolution",
        "compatibility"
      ],
      "badgeEnabled": {
        "type": true,
        "dynamic": true,
        "music": true,
        "reactive": true,
        "approved": true,
        "resolution": true,
        "compatibility": true
      },
      "autoApplyOnStartup": true,
      "panelPageSize": 24,
      "wallpaperScanCacheMinutes": 10,
      "panelLastSelectedPath": "",
      "screens": {},
      "wallpaperProperties": {},
      "lastKnownGoodScreens": {},
      "runtimeRecoveryPending": false
    }
  }
}
