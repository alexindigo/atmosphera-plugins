{
  "id": "mpd",
  "name": "MPD",
  "version": "1.1.8",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.11.0",
  "author": "Ido Perlmuter",
  "license": "MIT",
  "repository": "https://github.com/ido50/noctalia-mpd",
  "description": "MPD plugin for Noctalia",
  "tags": [
    "Bar",
    "Audio",
    "Music"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "leftButton": {"editorUsage": "configuration", "type": "String"},
        "middleButton": {"editorUsage": "configuration", "type": "String"},
        "rightButton": {"editorUsage": "configuration", "type": "String"},
        "shuffleStopsPlayback": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "leftButton": "next",
      "rightButton": "toggle",
      "middleButton": "shuffle",
      "shuffleStopsPlayback": true
    }
  }
}
