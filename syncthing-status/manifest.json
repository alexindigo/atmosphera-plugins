{
  "id": "syncthing-status",
  "name": "Syncthing Status",
  "version": "1.0.6",
  "minNoctaliaVersion": "4.4.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Pir0c0pter0",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Theme-aware Syncthing status plugin with bar and panel integration",
  "tags": ["Bar", "Panel", "System", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "apiKey": {"editorUsage": "configuration", "type": "String", "sensitive": true, "machineLocal": true},
        "apiUrl": {"editorUsage": "configuration", "type": "String"},
        "configPath": {"editorUsage": "configuration", "type": "String"},
        "enabled": {"editorUsage": "configuration", "type": "Boolean"},
        "folderIds": {"editorUsage": "configuration", "type": "List", "element": {"type": "String"}},
        "pollIntervalMs": {"editorUsage": "configuration", "type": "Real"},
        "verifyTls": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "apiKey": "",
      "enabled": true,
      "apiUrl": "",
      "configPath": "",
      "verifyTls": false,
      "pollIntervalMs": 10000,
      "folderIds": []
    }
  }
}
