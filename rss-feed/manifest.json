{
  "id": "rss-feed",
  "name": "RSS Feed Reader",
  "version": "1.0.9",
  "description": "Monitor and read RSS/Atom feeds directly from your desktop",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "author": "Lokize",
  "license": "MIT",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "feeds": {"type": "List", "element": {"type": "Record", "fields": {"name": {"type": "String"}, "url": {"type": "String"}}}},
        "markAsReadOnClick": {"type": "Boolean"},
        "maxItemsPerFeed": {"type": "Real"},
        "readItems": {"type": "List", "machineLocal": true, "element": {"type": "String"}},
        "showOnlyUnread": {"type": "Boolean"},
        "updateInterval": {"type": "Real"}
      }
    },
    "defaultSettings": {
      "feeds": [],
      "readItems": [],
      "updateInterval": 600,
      "maxItemsPerFeed": 10,
      "showOnlyUnread": false,
      "markAsReadOnClick": true
    }
  }
}
