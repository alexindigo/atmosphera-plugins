{
  "id": "amd-gpu-monitor",
  "name": "AMD GPU Monitor",
  "version": "1.0.5",
  "minNoctaliaVersion": "4.0.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Dvaxert",
  "license": "MIT",
  "description": "AMD discrete GPU monitoring via rocm-smi with graphs and configurable metrics.",
  "tags": ["Bar", "Panel", "System", "Amd", "GPU", "Monitoring", "Graph", "Video"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "compactMode": {"editorUsage": "configuration", "type": "Boolean"},
        "deviceIndex": {"editorUsage": "configuration", "type": "Real"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "showDcefclk": {"editorUsage": "configuration", "type": "Boolean"},
        "showFanSpeed": {"editorUsage": "configuration", "type": "Boolean"},
        "showFclk": {"editorUsage": "configuration", "type": "Boolean"},
        "showGpuUse": {"editorUsage": "configuration", "type": "Boolean"},
        "showMclk": {"editorUsage": "configuration", "type": "Boolean"},
        "showPower": {"editorUsage": "configuration", "type": "Boolean"},
        "showSclk": {"editorUsage": "configuration", "type": "Boolean"},
        "showSocclk": {"editorUsage": "configuration", "type": "Boolean"},
        "showTempEdge": {"editorUsage": "configuration", "type": "Boolean"},
        "showTempJunction": {"editorUsage": "configuration", "type": "Boolean"},
        "showTempMemory": {"editorUsage": "configuration", "type": "Boolean"},
        "showVram": {"editorUsage": "configuration", "type": "Boolean"},
        "showVramActivity": {"editorUsage": "configuration", "type": "Boolean"},
        "textColor": {"editorUsage": "configuration", "type": "String"},
        "useMonospaceFont": {"editorUsage": "configuration", "type": "Boolean"},
        "usePadding": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "deviceIndex": 0,
      "compactMode": true,
      "iconColor": "primary",
      "textColor": "onSurface",
      "useMonospaceFont": true,
      "usePadding": false,
      "showTempEdge": false,
      "showTempJunction": true,
      "showTempMemory": false,
      "showGpuUse": true,
      "showVram": true,
      "showVramActivity": false,
      "showFanSpeed": false,
      "showPower": true,
      "showSclk": true,
      "showMclk": true,
      "showFclk": false,
      "showSocclk": false,
      "showDcefclk": false
    }
  }
}
