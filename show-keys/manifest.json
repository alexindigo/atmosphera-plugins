{
    "id": "show-keys",
    "name": "Show Keys",
    "version": "1.0.8",
    "minNoctaliaVersion": "3.6.0",
    "minAtmospheraVersion": "0.11.0",
    "author": "onez3r0",
    "license": "MIT",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "description": "Floating OSD that displays keyboard input in real-time via evtest.",
    "tags": [
        "Indicator",
        "System"
    ],
    "entryPoints": {
        "main": "Main.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "settingsSchema": {
            "version": 1,
            "fields": {
                "captureEnabled": {"editorUsage": "configuration", "type": "Boolean"},
                "disabledScreens": {"editorUsage": "configuration", "type": "List", "element": {"type": "String"}},
                "evtestDevice": {"editorUsage": "configuration", "type": "String"},
                "hideDelaySec": {"editorUsage": "configuration", "type": "Real"},
                "marginPx": {"editorUsage": "configuration", "type": "Real"},
                "pillBg": {"editorUsage": "configuration", "type": "String", "optional": true},
                "pillColor": {"editorUsage": "configuration", "type": "String", "optional": true},
                "position": {"editorUsage": "configuration", "type": "String"},
                "useCustomColors": {"editorUsage": "configuration", "type": "Boolean", "optional": true}
            }
        },
        "defaultSettings": {
            "captureEnabled": true,
            "evtestDevice": "/dev/input/event3",
            "position": "bottom",
            "marginPx": 60,
            "hideDelaySec": 2,
            "disabledScreens": []
        }
    }
}
