{
  "id": "screen-toolkit",
  "name": "Screen Toolkit",
  "version": "1.3.8",
  "minNoctaliaVersion": "4.5.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "ycf-anon",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A set of screen tools: color picker, annotate, record, pin, OCR, QR scanner, palette, measure, and webcam mirror (deps: README).",
  "tags": [
    "Panel",
    "Bar",
    "Utility",
    "System"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "actions": [
    {"id": "toggle", "label": "Screen toolkit", "description": "Toggle screen tools and recent results.", "icon": "tools", "command": "atmosphera ipc plugin:screen-toolkit toggle"},
    {"id": "mirror", "label": "Webcam mirror", "description": "Open the webcam mirror.", "icon": "camera", "command": "atmosphera ipc plugin:screen-toolkit mirror"},
    {"id": "measure", "label": "Measure screen region", "description": "Measure a selected area in pixels.", "icon": "ruler", "command": "atmosphera ipc plugin:screen-toolkit measure"},
    {"id": "color-picker", "label": "Pick a color", "description": "Sample a color from the screen.", "icon": "color-picker", "command": "atmosphera ipc plugin:screen-toolkit colorPicker"},
    {"id": "annotate", "label": "Annotate a selected region of the screen", "description": "Select and annotate a screen region.", "icon": "pencil", "command": "atmosphera ipc plugin:screen-toolkit annotate"},
    {"id": "annotate-fullscreen", "label": "Annotate full screen", "description": "Annotate a capture of the full screen.", "icon": "device-desktop", "command": "atmosphera ipc plugin:screen-toolkit annotateFullscreen"},
    {"id": "pin", "label": "Pin screen region", "description": "Keep a captured region on screen.", "icon": "pin", "command": "atmosphera ipc plugin:screen-toolkit pin"},
    {"id": "pin-image", "label": "Pin image from file", "description": "Choose an image to keep on screen.", "icon": "photo", "command": "atmosphera ipc plugin:screen-toolkit pinImage"},
    {"id": "ocr", "label": "Extract text", "description": "Read text from a selected screen region.", "icon": "text-recognition", "command": "atmosphera ipc plugin:screen-toolkit ocr"},
    {"id": "qr", "label": "Read QR code", "description": "Read a QR code in a selected region.", "icon": "qrcode", "command": "atmosphera ipc plugin:screen-toolkit qr"},
    {"id": "palette", "label": "Extract palette", "description": "Find colors in a selected region.", "icon": "palette", "command": "atmosphera ipc plugin:screen-toolkit palette"},
    {"id": "lens", "label": "Screen lens", "description": "Magnify a selected region.", "icon": "zoom-in", "command": "atmosphera ipc plugin:screen-toolkit lens"},
    {"id": "record", "label": "Record region as GIF", "description": "Select a screen region to record.", "icon": "video", "command": "atmosphera ipc plugin:screen-toolkit record"},
    {"id": "record-mp4", "label": "Record region as MP4", "description": "Select a screen region to record.", "icon": "video", "command": "atmosphera ipc plugin:screen-toolkit recordMp4"},
    {"id": "record-fullscreen", "label": "Record full screen as GIF", "description": "Record the current screen.", "icon": "device-desktop", "command": "atmosphera ipc plugin:screen-toolkit recordFullscreen"},
    {"id": "record-fullscreen-mp4", "label": "Record full screen as MP4", "description": "Record the current screen as MP4.", "icon": "device-desktop", "command": "atmosphera ipc plugin:screen-toolkit recordFullscreenMp4"}
  ],
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSourceProjection": {
      "version": 1,
      "projectionId": "screen-toolkit-palette-list",
      "transform": "function(input) { var values = input.values; if (Object.prototype.hasOwnProperty.call(input.raw, 'paletteColors') && input.raw.paletteColors === '') values.paletteColors = []; return {values: values, compatibilityRaw: input.compatibilityRaw, effects: [], diagnostics: []}; }"
    },
    "settingsSchema": {
      "version": 1,
      "fields": {
        "colorHistory": {"type": "List", "machineLocal": true, "element": {"type": "String"}},
        "paletteColors": {"type": "List", "machineLocal": true, "element": {"type": "String"}},
        "installedLangs": {"type": "List", "machineLocal": true, "element": {"type": "String"}},
        "transAvailable": {"type": "Boolean", "machineLocal": true},
        "detectedRecorder": {"type": "String", "machineLocal": true},
        "resultHex": {"type": "String", "optional": true, "machineLocal": true},
        "resultRgb": {"type": "String", "optional": true, "machineLocal": true},
        "resultHsv": {"type": "String", "optional": true, "machineLocal": true},
        "resultHsl": {"type": "String", "optional": true, "machineLocal": true},
        "colorCapturePath": {"type": "String", "optional": true, "machineLocal": true},
        "colorCacheBust": {"type": "Real", "optional": true, "machineLocal": true},
        "ocrResult": {"type": "String", "optional": true, "machineLocal": true},
        "ocrCapturePath": {"type": "String", "optional": true, "machineLocal": true},
        "qrResult": {"type": "String", "optional": true, "machineLocal": true},
        "qrCapturePath": {"type": "String", "optional": true, "machineLocal": true},
        "translateResult": {"type": "String", "optional": true, "machineLocal": true},
        "filenameFormat": {"type": "String"},
        "gifMaxSeconds": {"type": "Real"},
        "recordCopyToClipboard": {"type": "Boolean"},
        "recordSkipConfirmation": {"type": "Boolean"},
        "screenshotPath": {"type": "String"},
        "searchEngineUrl": {"type": "String", "optional": true},
        "selectedOcrLang": {"type": "String"},
        "shareSkipPopover": {"type": "Boolean", "optional": true},
        "videoPath": {"type": "String"},
        "x02ApiKey": {"type": "String", "optional": true, "sensitive": true, "machineLocal": true},
        "x02Expiry": {"type": "String", "optional": true}
      }
    },
    "defaultSettings": {
      "colorHistory": [],
      "paletteColors": [],
      "installedLangs": ["eng"],
      "transAvailable": false,
      "detectedRecorder": "",
      "selectedOcrLang": "eng",
      "screenshotPath": "",
      "videoPath": "",
      "filenameFormat": "",
      "recordSkipConfirmation": false,
      "recordCopyToClipboard": false,
      "gifMaxSeconds": 30
    }
  }
}
