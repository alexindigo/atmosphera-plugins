{
  "id": "slowbongo",
  "name": "Slow Bongo",
  "version": "0.8.3",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "tui",
  "description": "A bongo cat that sits in your bar and slaps when you type.",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "tags": [
    "Bar",
    "Audio",
    "Fun"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "catColor": {"type": "String"},
        "catOffsetY": {"type": "Real"},
        "catSize": {"type": "Real"},
        "idleTimeout": {"type": "Real"},
        "inputDevice": {"type": "String", "optional": true},
        "inputDevices": {"type": "List", "optional": true, "element": {"type": "String"}},
        "raveMode": {"type": "Boolean"},
        "tappyMode": {"type": "Boolean"},
        "useMprisFilter": {"type": "Boolean"},
        "waitingTimeout": {"type": "Real"},
        "widthPadding": {"type": "Real", "optional": true}
      }
    },
    "defaultSettings": {
      "idleTimeout": 150,
      "waitingTimeout": 30000,
      "catColor": "default",
      "catSize": 1.0,
      "catOffsetY": 0.0,
      "raveMode": false,
      "tappyMode": false,
      "useMprisFilter": false
    }
  }
}
