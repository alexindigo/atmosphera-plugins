{
  "id": "assistant-panel",
  "name": "Assistant Panel",
  "version": "2.1.11",
  "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.10.0",
  "author": "j-1in",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "AI Chat and Translation panel",
  "tags": [
    "Bar",
    "Panel",
    "AI",
    "Productivity",
    "Network"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "ai": {"editorUsage": "configuration", "type": "Record", "machineLocal": true, "fields": {"provider": {"type": "String","optional": true},"model": {"type": "String","optional": true},"models": {"type": "Map","element": {"type": "String"},"optional": true},"apiKeys": {"type": "Map", "machineLocal": true, "element": {"type": "String","sensitive": true,"machineLocal": true},"sensitive": true,"optional": true},"temperature": {"type": "Real","optional": true},"systemPrompt": {"type": "String","optional": true},"maxHistoryLength": {"type": "Real","optional": true},"openaiLocal": {"type": "Boolean","optional": true},"openaiBaseUrl": {"type": "String","optional": true}}},
        "attachmentStyle": {"editorUsage": "configuration", "type": "String","optional": true},
        "maxHistoryLength": {"editorUsage": "configuration", "type": "Real"},
        "panelDetached": {"editorUsage": "configuration", "type": "Boolean"},
        "panelHeightRatio": {"editorUsage": "configuration", "type": "Real"},
        "panelPosition": {"editorUsage": "configuration", "type": "String"},
        "panelWidth": {"editorUsage": "configuration", "type": "Real"},
        "scale": {"editorUsage": "configuration", "type": "Real"},
        "translator": {"editorUsage": "configuration", "type": "Record", "machineLocal": true, "fields": {"backend": {"type": "String","optional": true},"sourceLanguage": {"type": "String","optional": true},"targetLanguage": {"type": "String","optional": true},"realTimeTranslation": {"type": "Boolean","optional": true},"deeplApiKey": {"type": "String","sensitive": true,"machineLocal": true,"optional": true}}}
      }
    },
    "defaultSettings": {
      "maxHistoryLength": 100,
      "panelDetached": true,
      "panelPosition": "right",
      "panelHeightRatio": 0.85,
      "panelWidth": 520,
      "scale": 1,
      "ai": {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "apiKeys": {},
        "temperature": 0.7,
        "systemPrompt": "You are a helpful assistant integrated into a Linux desktop shell. Be concise and helpful.",
        "maxHistoryLength": 100,
        "openaiLocal": false,
        "openaiBaseUrl": "https://api.openai.com/v1/chat/completions"
      },
      "translator": {
        "backend": "google",
        "sourceLanguage": "auto",
        "targetLanguage": "en",
        "realTimeTranslation": true,
        "deeplApiKey": ""
      }
    }
  }
}
