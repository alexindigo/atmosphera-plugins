{
  "id": "hot-corners",
  "name": "Hot Corners",
  "version": "0.0.6",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "sapjax",
  "official": false,
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A macOS-style hot corners plugin for Noctalia Shell.",
  "tags": [
    "Desktop",
    "Productivity"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "corners": {
          "type": "Record",
          "optional": true,
          "fields": {
            "BottomLeft": {"type": "String", "optional": true},
            "BottomRight": {"type": "String", "optional": true},
            "TopLeft": {"type": "String", "optional": true},
            "TopRight": {"type": "String", "optional": true}
          }
        }
      }
    }
  }
}
