{
  "id": "ramadan-iftar",
  "name": "Ramadan Iftar",
  "version": "1.0.8",
  "minNoctaliaVersion": "4.1.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "User",
  "license": "MIT",
  "description": "Shows prayer times and a countdown to Iftar during Ramadan.",
  "tags": [
    "Bar",
    "Panel"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "city": {"editorUsage": "configuration", "type": "String"},
        "country": {"editorUsage": "configuration", "type": "String"},
        "method": {"editorUsage": "configuration", "type": "Real"},
        "showAlways": {"editorUsage": "configuration", "type": "Boolean"},
        "showCountdown": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "city": "London",
      "country": "UK",
      "method": 3,
      "showAlways": true,
      "showCountdown": true
    }
  }
}
