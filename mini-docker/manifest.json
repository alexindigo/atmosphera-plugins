{
  "id": "mini-docker",
  "name": "Mini Docker",
  "version": "2.2.6",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "MannuVilasara",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Manage Docker containers, images, volumes & networks",
  "tags": [
    "Bar",
    "Panel",
    "Development"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "activeColor": {"editorUsage": "configuration", "type": "String"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "inactiveColor": {"editorUsage": "configuration", "type": "String"},
        "refreshInterval": {"editorUsage": "configuration", "type": "Real"},
        "statusState": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "refreshInterval": 5000,
      "iconColor": "none",
      "statusState": "all",
      "activeColor": "success",
      "inactiveColor": "error"
    }
  }
}
