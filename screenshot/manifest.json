{
  "id": "screenshot",
  "name": "Screenshot",
  "version": "1.2.6",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Cleboost",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Quick screenshot button in bar for Hyprland, Sway, and Niri",
  "tags": [
    "Bar",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "actions": [
    {
      "id": "take", "label": "Take screenshot", "description": "Choose a mode; on niri the native picker opens.",
      "icon": "screenshot", "command": "atmosphera ipc plugin:screenshot takeScreenshot",
      "arguments": [{"name": "mode", "label": "Mode", "type": "choice", "default": "region", "choices": [
        {"value": "region", "label": "Region"},
        {"value": "window", "label": "Window"},
        {"value": "active-window", "label": "Active window"},
        {"value": "active-screen", "label": "Active screen"}
      ]}]
    }
  ],
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "mode": {"type": "String"}
      }
    },
    "defaultSettings": {
      "mode": "region"
    }
  }
}
