{
  "id": "mpris-lyric",
  "name": "MPRIS Lyric",
  "version": "1.0.13",
  "minNoctaliaVersion": "3.8.0",
  "minAtmospheraVersion": "0.11.0",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "author": "DBeidachazi",
  "license": "MIT",
  "description": "Display synchronized lyrics from MPRIS-compatible music players (e.g., go-musicfox) in the bar.",
  "tags": [
    "Bar",
    "Music"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "hideWhenInactive": {"editorUsage": "configuration", "type": "Boolean"},
        "playerName": {"editorUsage": "configuration", "type": "String"},
        "updateInterval": {"editorUsage": "configuration", "type": "Real"},
        "width": {"editorUsage": "configuration", "type": "Real"}
      }
    },
    "defaultSettings": {
      "playerName": "musicfox",
      "hideWhenInactive": false,
      "updateInterval": 200,
      "width": 300
    }
  }
}
