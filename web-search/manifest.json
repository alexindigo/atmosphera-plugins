{
    "id": "web-search",
    "name": "Web Search",
  "version": "1.1.11",
    "author": "Rigelyon",
    "license": "MIT",
    "description": "Search the Internet from the Launcher.",
    "minNoctaliaVersion": "3.9.0",
  "minAtmospheraVersion": "0.11.0",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "tags": [
        "Launcher",
        "Utility"
    ],
    "entryPoints": {
        "main": "Main.qml",
        "launcherProvider": "LauncherProvider.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "commandPrefix": "web",
        "settingsSchema": {
          "version": 1,
          "fields": {
            "direct_url": {"editorUsage": "configuration", "type": "Boolean"},
            "max_results": {"editorUsage": "configuration", "type": "Real"},
            "search_engine": {"editorUsage": "configuration", "type": "String"},
            "show_suggestions": {"editorUsage": "configuration", "type": "Boolean"}
          }
        },
        "defaultSettings": {
            "search_engine": "Google",
            "direct_url": true,
            "show_suggestions": true,
            "max_results": 5
        }
    }
}
