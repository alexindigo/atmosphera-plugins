{
  "id": "obs-control",
  "name": "OBS Control",
  "version": "0.1.5",
  "author": "ayagmar",
  "description": "OBS recording, replay, and stream status widget for Noctalia.",
  "tags": [
    "Bar",
    "Panel",
    "Indicator",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "settings": "Settings.qml",
    "panel": "Panel.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoCloseManagedObs": {"type": "Boolean"},
        "barLabelMode": {"type": "String"},
        "launchBehavior": {"type": "String"},
        "leftClickAction": {"type": "String"},
        "openVideosAfterStop": {"type": "Boolean"},
        "pollIntervalMs": {"type": "Real"},
        "showBarWhenReady": {"type": "Boolean"},
        "showBarWhenRecording": {"type": "Boolean"},
        "showBarWhenReplay": {"type": "Boolean"},
        "showBarWhenStreaming": {"type": "Boolean"},
        "showControlCenterWhenReady": {"type": "Boolean"},
        "showControlCenterWhenRecording": {"type": "Boolean"},
        "showControlCenterWhenReplay": {"type": "Boolean"},
        "showControlCenterWhenStreaming": {"type": "Boolean"},
        "showElapsedInBar": {"type": "Boolean"},
        "videosOpener": {"type": "String"},
        "videosPath": {"type": "String"}
      }
    },
    "defaultSettings": {
      "pollIntervalMs": 2500,
      "leftClickAction": "panel",
      "launchBehavior": "minimized-to-tray",
      "barLabelMode": "short-label",
      "videosPath": "",
      "videosOpener": "xdg-open",
      "autoCloseManagedObs": true,
      "openVideosAfterStop": true,
      "showBarWhenRecording": true,
      "showBarWhenReplay": false,
      "showBarWhenStreaming": true,
      "showBarWhenReady": true,
      "showControlCenterWhenRecording": true,
      "showControlCenterWhenReplay": true,
      "showControlCenterWhenStreaming": true,
      "showControlCenterWhenReady": false,
      "showElapsedInBar": false
    }
  }
}
