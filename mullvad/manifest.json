{
	"id": "mullvad",
	"name": "Mullvad VPN",
	"version": "0.1.3",
	"minNoctaliaVersion": "4.0.0",
	"minAtmospheraVersion": "0.10.0",
	"author": "OCSPG",
	"license": "MIT",
	"repository": "https://github.com/noctalia-dev/noctalia-plugins",
	"description": "Control Mullvad VPN from the bar: connect/disconnect, pick relays, toggle lockdown mode, multihop and more.",
	"tags": [
		"Bar",
		"Network",
		"Panel"
	],
	"entryPoints": {
		"main": "Main.qml",
		"barWidget": "BarWidget.qml",
		"panel": "Panel.qml",
		"settings": "Settings.qml"
	},
	"dependencies": {
		"plugins": []
	},
	"metadata": {
		"settingsSchema": {
			"version": 1,
			"fields": {
				"clickAction": {"type": "String"},
				"compactMode": {"type": "Boolean"},
				"confirmDisconnectInLockdown": {"type": "Boolean"},
				"expiryWarningDays": {"type": "Real"},
				"favoriteCountries": {"type": "List", "element": {"type": "String"}},
				"refreshInterval": {"type": "Real"},
				"relayClickConnects": {"type": "Boolean"},
				"showCityName": {"type": "Boolean"},
				"showCountryFlag": {"type": "Boolean"},
				"showIp": {"type": "Boolean"}
			}
		},
		"defaultSettings": {
			"refreshInterval": 3000,
			"showCountryFlag": true,
			"showCityName": false,
			"showIp": false,
			"compactMode": false,
			"clickAction": "panel",
			"relayClickConnects": true,
			"confirmDisconnectInLockdown": true,
			"favoriteCountries": [],
			"expiryWarningDays": 7
		}
	}
}
