{
  "id": "keep-awake-plus",
  "name": "Keep Awake+",
  "version": "0.3.5",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "Noam Stolero",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Duration+scope Keep Awake with persistent last-choice and partial/full inhibit modes.",
  "tags": ["Bar", "Panel", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "controlCenterWidget": "ControlCenterWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": { "plugins": [] },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "activateOnLeftClick": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultScope": {"editorUsage": "configuration", "type": "String"},
        "durations": {"editorUsage": "configuration", "type": "List","element": {"type": "Real"}},
        "includeUnlimited": {"editorUsage": "configuration", "type": "Boolean"},
        "quickExtendMinutes": {"editorUsage": "configuration", "type": "Real"},
        "showRemainingText": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "defaultScope": "partial",
      "durations": [30, 60, 120, 240, 480],
      "includeUnlimited": true,
      "showRemainingText": true,
      "activateOnLeftClick": false,
      "quickExtendMinutes": 30
    }
  }
}
