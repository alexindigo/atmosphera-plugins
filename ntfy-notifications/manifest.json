{
  "id": "ntfy-notifications",
  "name": "ntfy Notifications",
  "version": "1.0.9",
  "minNoctaliaVersion": "4.4.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "maxe",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Subscribe to ntfy topics and receive push notifications directly in your bar, with full theming support",
  "tags": [
    "Bar",
    "Panel",
    "Network",
    "Indicator"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "authMethod": {"editorUsage": "configuration", "type": "String"},
        "authPassword": {"editorUsage": "configuration", "type": "String", "machineLocal": true, "sensitive": true},
        "authToken": {"editorUsage": "configuration", "type": "String", "machineLocal": true, "sensitive": true},
        "authUsername": {"editorUsage": "configuration", "type": "String", "machineLocal": true, "sensitive": true},
        "enableToasts": {"editorUsage": "configuration", "type": "Boolean"},
        "maxMessages": {"editorUsage": "configuration", "type": "Real"},
        "pollInterval": {"editorUsage": "configuration", "type": "Real"},
        "readMessageIds": {"editorUsage": "operational", "type": "List", "machineLocal": true, "element": {"type": "String"}},
        "serverUrl": {"editorUsage": "configuration", "type": "String"},
        "topics": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "serverUrl": "https://ntfy.sh",
      "topics": "",
      "authMethod": "none",
      "authToken": "",
      "authUsername": "",
      "authPassword": "",
      "readMessageIds": [],
      "pollInterval": 30,
      "enableToasts": true,
      "maxMessages": 100
    }
  }
}
