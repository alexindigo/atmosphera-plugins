{
  "id": "niri-screensaver",
  "name": "Niri Screensaver",
  "version": "0.8.6",
  "minNoctaliaVersion": "4.7.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "jfreed-dev",
  "license": "GPL-3.0-only",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Idle-aware terminal screensaver for niri, driven by TerminalTextEffects.",
  "tags": ["Bar", "Utility", "Niri"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "batteryMinPercent": {"type": "Real"},
        "clockDuration": {"type": "Real"},
        "clockFont": {"type": "String"},
        "clockFormat": {"type": "String"},
        "cursorHide": {"type": "Boolean"},
        "cursorWarp": {"type": "Boolean"},
        "dismissOnKey": {"type": "Boolean"},
        "enabled": {"type": "Boolean"},
        "excludeEffects": {"type": "String"},
        "fadeInEffect": {"type": "String"},
        "fadeOutEffect": {"type": "String"},
        "frameRate": {"type": "Real"},
        "idleSeconds": {"type": "Real"},
        "includeEffects": {"type": "String"},
        "killCommand": {"type": "String"},
        "launcherCommand": {"type": "String"},
        "logoDir": {"type": "String"},
        "logoPath": {"type": "String"},
        "multiMonitorMode": {"type": "String"},
        "nowPlayingDuration": {"type": "Real"},
        "randomLogo": {"type": "Boolean"},
        "showClock": {"type": "Boolean"},
        "showNowPlaying": {"type": "Boolean"}
      }
    },
    "defaultSettings": {
      "enabled": true,
      "idleSeconds": 300,
      "batteryMinPercent": 0,
      "frameRate": 60,
      "includeEffects": "",
      "excludeEffects": "dev_worm",
      "fadeInEffect": "",
      "fadeOutEffect": "",
      "showClock": false,
      "clockDuration": 3,
      "clockFormat": "%H:%M",
      "clockFont": "",
      "showNowPlaying": false,
      "nowPlayingDuration": 3,
      "logoPath": "",
      "cursorHide": true,
      "cursorWarp": false,
      "dismissOnKey": true,
      "randomLogo": false,
      "logoDir": "",
      "multiMonitorMode": "independent",
      "launcherCommand": "niri-screensaver-launch launch",
      "killCommand": "niri-screensaver-launch kill"
    }
  }
}
