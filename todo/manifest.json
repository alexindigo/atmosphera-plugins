{
  "id": "todo",
  "name": "Todo List",
  "version": "1.10.9",
  "minNoctaliaVersion": "3.7.1",
  "minAtmospheraVersion": "0.10.0",
  "author": "lonerOrz <lonerOrz@qq.com>",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A simple todo list manager plugin for Noctalia Shell.",
  "tags": ["Bar", "Desktop", "Panel", "Productivity"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "desktopWidget": "DesktopWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml",
    "controlCenterWidget": "ControlCenterWidget.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "todos": {"type": "List", "editorUsage": "content", "machineLocal": true, "element": {"type": "Record", "fields": {"id": {"type": "Real", "optional": true}, "text": {"type": "String", "optional": true}, "completed": {"type": "Boolean", "optional": true}, "createdAt": {"type": "String", "optional": true}, "pageId": {"type": "Real", "optional": true}, "priority": {"type": "String", "optional": true}, "details": {"type": "String", "optional": true}}}},
        "pages": {"type": "List", "editorUsage": "content", "machineLocal": true, "element": {"type": "Record", "fields": {"id": {"type": "Real"}, "name": {"type": "String"}}}},
        "current_page_id": {"type": "Real", "editorUsage": "content", "machineLocal": true},
        "count": {"type": "Real", "editorUsage": "operational", "machineLocal": true},
        "completedCount": {"type": "Real", "editorUsage": "operational", "machineLocal": true},
        "exportEmptySections": {"type": "Boolean", "editorUsage": "configuration"},
        "exportFormat": {"type": "String", "editorUsage": "configuration"},
        "exportPath": {"type": "String", "editorUsage": "configuration"},
        "isExpanded": {"type": "Boolean", "editorUsage": "configuration"},
        "priorityColors": {"type": "Record", "editorUsage": "configuration", "fields": {"high": {"type": "String", "optional": true}, "medium": {"type": "String", "optional": true}, "low": {"type": "String", "optional": true}}},
        "showBackground": {"type": "Boolean", "editorUsage": "configuration"},
        "showCompleted": {"type": "Boolean", "editorUsage": "configuration"},
        "useCustomColors": {"type": "Boolean", "editorUsage": "configuration"}
      }
    },
    "defaultSettings": {
      "todos": [],
      "pages": [{"id": 0, "name": "General"}],
      "current_page_id": 0,
      "count": 0,
      "completedCount": 0,
      "showCompleted": true,
      "showBackground": true,
      "isExpanded": false,
      "useCustomColors": false,
      "priorityColors": {
        "high": "#f44336",
        "medium": "#2196f3",
        "low": "#9e9e9e"
      },
      "exportPath": "~/Documents",
      "exportFormat": "markdown",
      "exportEmptySections": false
    }
  }
}
