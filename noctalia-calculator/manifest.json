{
  "id": "noctalia-calculator",
  "name": "Calculator",
  "version": "1.1.10",
  "minNoctaliaVersion": "4.4.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "pir0c0pter0",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Theme-aware calculator plugin for Noctalia on Niri with bar widget, floating panel and keyboard support",
  "tags": ["Bar", "Panel", "Utility"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "actions": [
    {"id": "toggle", "label": "Calculator", "description": "Toggle the calculator panel.", "icon": "calculator", "command": "atmosphera ipc plugin:noctalia-calculator toggle"}
  ],
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "precision": {"editorUsage": "configuration", "type": "Real"},
        "showBarValue": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "showBarValue": true,
      "precision": 8
    }
  }
}
