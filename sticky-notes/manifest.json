{
  "id": "sticky-notes",
  "name": "Sticky Notes",
  "version": "0.0.13",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "sapjax",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A local quick notes plugin with Markdown support.",
  "tags": [
    "Bar",
    "Panel",
    "Productivity"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "githubGistId": {"editorUsage": "operational", "type": "String"},
        "githubToken": {"editorUsage": "configuration", "type": "String", "sensitive": true, "machineLocal": true},
        "notes": {"editorUsage": "content", "type": "String"},
        "syncEnabled": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "notes": "[]",
      "syncEnabled": false,
      "githubToken": "",
      "githubGistId": ""
    }
  }
}
