{
  "id": "hyprland-steam-overlay",
  "name": "Steam Overlay (Hyprland)",
  "version": "2.2.9",
  "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.10.0",
  "author": "blacku",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "license": "MIT",
  "description": "[DEPRECATED — not maintained from Hyprland 0.55+] Steam overlay with automatic window management for Hyprland. Due to Hyprland 0.55 deprecating hyprlang in favour of Lua (changing hyprctl dispatch parsing and popup/xdg handling), this plugin is no longer actively maintained. The 2.2.0 release adds a best-effort dual-mode dispatch fix and an optional custom Lua layout, but no further updates are planned. Automatically moves all Steam windows (except fullscreen games) to an overlay workspace; main 3 windows (Friends, Client, Chat) positioned in a row, fully responsive percentage-based layout. Requires Hyprland window manager.",
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoLaunchSteam": {"editorUsage": "configuration", "type": "Boolean"},
        "chatWidth": {"editorUsage": "configuration", "type": "Real","optional": true},
        "chatWidthPercent": {"editorUsage": "configuration", "type": "Real"},
        "enableChatNotifications": {"editorUsage": "configuration", "type": "Boolean","optional": true},
        "friendsWidth": {"editorUsage": "configuration", "type": "Real","optional": true},
        "friendsWidthPercent": {"editorUsage": "configuration", "type": "Real"},
        "gapSize": {"editorUsage": "configuration", "type": "Real"},
        "mainWidth": {"editorUsage": "configuration", "type": "Real","optional": true},
        "mainWidthPercent": {"editorUsage": "configuration", "type": "Real"},
        "topMarginPercent": {"editorUsage": "configuration", "type": "Real"},
        "useCustomLayout": {"editorUsage": "configuration", "type": "Boolean"},
        "windowHeightPercent": {"editorUsage": "configuration", "type": "Real"}
      }
    },
    "defaultSettings": {
      "autoLaunchSteam": true,
      "useCustomLayout": false,
      "friendsWidthPercent": 10,
      "mainWidthPercent": 60,
      "chatWidthPercent": 25,
      "gapSize": 10,
      "topMarginPercent": 2.5,
      "windowHeightPercent": 95
    }
  }
}
