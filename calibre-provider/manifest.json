{
    "id": "calibre-provider",
    "name": "Calibre Provider",
    "version": "1.3.7",
    "minAtmospheraVersion": "0.10.0",
    "description": "Search for books in your Calibre library",
    "tags": ["Launcher"],
    "minNoctaliaVersion": "4.6.1",
    "author": "Krendil",
    "license": "MIT",
    "repository": "https://github.com/noctalia-dev/noctalia-plugins",
    "entryPoints": {
        "main": "Main.qml",
        "launcherProvider": "LauncherProvider.qml",
        "settings": "Settings.qml"
    },
    "dependencies": {
        "plugins": []
    },
    "metadata": {
        "commandPrefix": "cb",
        "settingsSchema": {
          "version": 1,
          "fields": {
            "forceGrid": {"editorUsage": "configuration", "type": "Boolean"},
            "launcher": {"editorUsage": "configuration", "type": "String"},
            "recentlyOpenedFiles": {"editorUsage": "operational", "type": "List", "machineLocal": true, "element": {"type": "Real"}},
            "recentlyOpenedMax": {"editorUsage": "configuration", "type": "Real"}
          }
        },
        "defaultSettings": {
            "launcher": "xdg-open",
            "forceGrid": false,
            "recentlyOpenedMax": 36,
            "recentlyOpenedFiles": []
        }
    }
}
