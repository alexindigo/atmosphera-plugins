{
  "id": "model-usage",
  "name": "Model Usage",
  "version": "0.3.7",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "cmptr",
  "license": "MIT",
  "description": "Shows AI coding assistant usage stats in the bar with detail panel (Claude Code, Codex, Copilot, Gemini, OpenRouter, Zen)",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "tags": [
    "Bar",
    "Productivity",
    "AI"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "barCycleIntervalSec": {"editorUsage": "configuration", "type": "Real"},
        "barDisplayMode": {"editorUsage": "configuration", "type": "String"},
        "barMetric": {"editorUsage": "configuration", "type": "String"},
        "providers": {"editorUsage": "configuration", "type": "Record", "machineLocal": true, "fields": {"claude": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true},"statsPath": {"type": "String","optional": true},"credentialsPath": {"type": "String","optional": true}},"optional": true},"codex": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true}},"optional": true},"copilot": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true}},"optional": true},"gemini": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true}},"optional": true},"openrouter": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true},"apiKey": {"type": "String","sensitive": true,"machineLocal": true,"optional": true}},"optional": true},"zen": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true},"apiKey": {"type": "String","sensitive": true,"machineLocal": true,"optional": true},"apiBaseUrl": {"type": "String","optional": true}},"optional": true}}},
        "refreshIntervalSec": {"editorUsage": "configuration", "type": "Real"}
      }
    },
    "defaultSettings": {
      "providers": {
        "claude": {
          "enabled": false,
          "statsPath": "~/.claude/stats-cache.json",
          "credentialsPath": "~/.claude/.credentials.json"
        },
        "codex": {
          "enabled": false
        },
        "copilot": {
          "enabled": false
        },
        "gemini": {
          "enabled": false
        },
        "openrouter": {
          "enabled": false,
          "apiKey": ""
        },
        "zen": {
          "enabled": false,
          "apiKey": ""
        }
      },
      "barDisplayMode": "active",
      "barCycleIntervalSec": 5,
      "barMetric": "prompts",
      "refreshIntervalSec": 30
    }
  }
}
