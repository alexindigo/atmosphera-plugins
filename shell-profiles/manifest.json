{
  "id": "shell-profiles",
  "name": "Profiles",
  "version": "1.0.16",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.10.0",
  "author": "Archlexx",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Save, load, and manage Noctalia configuration profiles.",
  "tags": [
    "Bar",
    "Theming",
    "Utility",
    "Panel"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "profilesDir": "",
      "icon": "wand",
      "iconColor": "primary",
      "includeWallpapers": true,
      "lastAppliedProfile": "",
      "backupEnabled": true,
      "backupCount": 5
    },
    "settingsSchema": {
      "version": 1,
      "fields": {
        "profilesDir": {"editorUsage": "configuration", "type": "String", "machineLocal": true},
        "icon": {"editorUsage": "configuration", "type": "String"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "includeWallpapers": {"editorUsage": "configuration", "type": "Boolean"},
        "lastAppliedProfile": {"editorUsage": "operational", "type": "String", "machineLocal": true},
        "backupEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "backupCount": {"editorUsage": "configuration", "type": "Real"}
      }
    }
  }
}
