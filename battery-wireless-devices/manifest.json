{
  "id": "battery-wireless-devices",
  "name": "Battery for Wireless Devices",
   "version": "1.0.8",
  "minNoctaliaVersion": "4.6.6",
   "minAtmospheraVersion": "0.10.0",
  "author": "aslauw",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Bar widget showing battery levels for wireless peripherals (mouse, keyboard, headset, etc.) via OpenRazer and Solaar.",
  "tags": ["Bar", "Indicator", "System"],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "deviceOrder": {"editorUsage": "configuration", "type": "List","element": {"type": "String"}},
        "devices": {"editorUsage": "configuration", "type": "Map","element": {"type": "Record","fields": {"enabled": {"type": "Boolean","optional": true},"icon": {"type": "String","optional": true},"iconColor": {"type": "String","optional": true},"ringColor": {"type": "String","optional": true},"launchCmd": {"type": "String","optional": true},"name": {"type": "String","optional": true},"type": {"type": "String","optional": true}}}},
        "refreshInterval": {"editorUsage": "configuration", "type": "Real"},
        "showCharging": {"editorUsage": "configuration", "type": "Boolean"},
        "showPercentage": {"editorUsage": "configuration", "type": "Boolean"}
      }
    },
    "defaultSettings": {
      "refreshInterval": 60,
      "showPercentage": false,
      "showCharging": false,
      "devices": {},
      "deviceOrder": []
    }
  }
}
