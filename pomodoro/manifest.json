{
  "id": "pomodoro",
  "name": "Pomodoro",
  "version": "1.2.6",
  "minNoctaliaVersion": "4.0.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "notprayasmitra",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "A pomodoro timer plugin to help boost productivity.",
  "tags": [
    "Bar",
    "Productivity"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoStartBreaks": {"type": "Boolean", "editorUsage": "configuration"},
        "autoStartWork": {"type": "Boolean", "editorUsage": "configuration"},
        "compactMode": {"type": "Boolean", "editorUsage": "configuration", "optional": true},
        "longBreakDuration": {"type": "Real", "editorUsage": "configuration"},
        "playSound": {"type": "Boolean", "editorUsage": "configuration", "optional": true},
        "sessionsBeforeLongBreak": {"type": "Real", "editorUsage": "configuration"},
        "shortBreakDuration": {"type": "Real", "editorUsage": "configuration"},
        "workDuration": {"type": "Real", "editorUsage": "configuration"}
      }
    },
    "defaultSettings": {
      "workDuration": 25,
      "shortBreakDuration": 5,
      "longBreakDuration": 15,
      "sessionsBeforeLongBreak": 4,
      "autoStartBreaks": false,
      "autoStartWork": false
    }
  }
}
