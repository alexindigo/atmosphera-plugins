{
  "id": "mawaqit",
  "name": "Mawaqit",
  "version": "1.3.13",
  "minNoctaliaVersion": "4.1.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "User",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Shows prayer times with a live countdown and a Hijri calendar with Islamic events.",
  "tags": [
    "Bar",
    "Panel"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "city": {"editorUsage": "configuration", "type": "String"},
        "country": {"editorUsage": "configuration", "type": "String"},
        "method": {"editorUsage": "configuration", "type": "Real"},
        "school": {"editorUsage": "configuration", "type": "Real"},
        "showCountdown": {"editorUsage": "configuration", "type": "Boolean"},
        "showElapsed": {"editorUsage": "configuration", "type": "Boolean"},
        "hidePrayerName": {"editorUsage": "configuration", "type": "Boolean"},
        "showNotifications": {"editorUsage": "configuration", "type": "Boolean"},
        "playAzan": {"editorUsage": "configuration", "type": "Boolean"},
        "azanFile": {"editorUsage": "configuration", "type": "String"},
        "hijriDayOffset": {"editorUsage": "configuration", "type": "Real"},
        "tune": {"editorUsage": "configuration", "type": "Boolean"},
        "tuneFajr": {"editorUsage": "configuration", "type": "Real"},
        "tuneDhuhr": {"editorUsage": "configuration", "type": "Real"},
        "tuneAsr": {"editorUsage": "configuration", "type": "Real"},
        "tuneMaghrib": {"editorUsage": "configuration", "type": "Real"},
        "tuneIsha": {"editorUsage": "configuration", "type": "Real"},
        "widgetIcon": {"editorUsage": "configuration", "type": "String"},
        "dynamicIcon": {"editorUsage": "configuration", "type": "Boolean"},
        "textColor": {"editorUsage": "configuration", "type": "String"},
        "iconColor": {"editorUsage": "configuration", "type": "String"},
        "activeColor": {"editorUsage": "configuration", "type": "String"},
        "weekStartDay": {"editorUsage": "configuration", "type": "Real", "optional": true},
        "fajrAngle": {"editorUsage": "configuration", "type": "Real", "nullable": true, "optional": true},
        "ishaAngle": {"editorUsage": "configuration", "type": "Real", "nullable": true, "optional": true},
        "_cacheData": {"editorUsage": "operational", "type": "String", "nullable": true, "optional": true, "machineLocal": true},
        "_cacheCity": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true},
        "_cacheCountry": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true},
        "_cacheMethod": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true},
        "_cacheSchool": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true},
        "_cacheSavedAt": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true},
        "_cacheFajrAngle": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true},
        "_cacheIshaAngle": {"editorUsage": "operational", "type": "String", "optional": true, "machineLocal": true}
      }
    },
    "defaultSettings": {
      "city": "London",
      "country": "UK",
      "method": 3,
      "school": 0,
      "showCountdown": true,
      "showElapsed": false,
      "hidePrayerName": false,
      "showNotifications": true,
      "playAzan": false,
      "azanFile": "azan1.mp3",
      "hijriDayOffset": 0,
      "tune": false,
      "tuneFajr": 0,
      "tuneDhuhr": 0,
      "tuneAsr": 0,
      "tuneMaghrib": 0,
      "tuneIsha": 0,
      "widgetIcon": "building-mosque",
      "dynamicIcon": false,
      "textColor": "none",
      "iconColor": "none",
      "activeColor": "primary"
    }
  }
}
