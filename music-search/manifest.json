{
  "id": "music-search",
  "name": "Music Search",
  "version": "1.2.17",
  "minNoctaliaVersion": "4.6.6",
  "minAtmospheraVersion": "0.11.0",
  "author": "kevichi7",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Search YouTube, play audio in the background with mpv, and save favorites into a persistent library.",
  "tags": [
    "Bar",
    "Panel",
    "Launcher",
    "Audio",
    "Music"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "music-search",
    "settingsSchema": {
      "version": 1,
      "fields": {
        "autoSaveMp3AfterPlayback": {"editorUsage": "configuration", "type": "Boolean"},
        "defaultPanelLibrarySection": {"editorUsage": "configuration", "type": "String"},
        "defaultPanelTab": {"editorUsage": "configuration", "type": "String"},
        "panelDensity": {"editorUsage": "configuration", "type": "String"},
        "previewMetadataMode": {"editorUsage": "configuration", "type": "String"},
        "previewPaneWidth": {"editorUsage": "configuration", "type": "Real"},
        "previewThumbnailSize": {"editorUsage": "configuration", "type": "String"},
        "showAlbumMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "showBarHoverTrackTitle": {"editorUsage": "configuration", "type": "Boolean"},
        "showDurationMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "showHomeArtists": {"editorUsage": "configuration", "type": "Boolean"},
        "showHomePlaylists": {"editorUsage": "configuration", "type": "Boolean"},
        "showHomeRecent": {"editorUsage": "configuration", "type": "Boolean"},
        "showHomeTags": {"editorUsage": "configuration", "type": "Boolean"},
        "showHomeTop": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelHeader": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelNowPlaying": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelPlaybackProgress": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelPreview": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelProviderChips": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelQueueControls": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelRecentTracks": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelSearchHelper": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelSpeedControls": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelStatusBanner": {"editorUsage": "configuration", "type": "Boolean"},
        "showPanelUrlActions": {"editorUsage": "configuration", "type": "Boolean"},
        "showPlayStatsMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "showPreviewChips": {"editorUsage": "configuration", "type": "Boolean"},
        "showRatingMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "showStatusMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "showTagMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "showUploaderMetadata": {"editorUsage": "configuration", "type": "Boolean"},
        "ytPlayerClient": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "previewMetadataMode": "always",
      "showUploaderMetadata": true,
      "showAlbumMetadata": true,
      "showDurationMetadata": true,
      "showRatingMetadata": true,
      "showTagMetadata": true,
      "showPlayStatsMetadata": true,
      "showStatusMetadata": true,
      "showPreviewChips": true,
      "previewThumbnailSize": "comfortable",
      "showHomeRecent": true,
      "showHomeTop": true,
      "showHomeTags": true,
      "showHomeArtists": true,
      "showHomePlaylists": true,
      "defaultPanelTab": "search",
      "defaultPanelLibrarySection": "tracks",
      "panelDensity": "balanced",
      "showPanelHeader": true,
      "showPanelNowPlaying": true,
      "showPanelPlaybackProgress": true,
      "showPanelProviderChips": true,
      "showPanelRecentTracks": true,
      "showPanelSearchHelper": true,
      "showPanelPreview": true,
      "previewPaneWidth": 0,
      "showPanelUrlActions": true,
      "showPanelSpeedControls": true,
      "showPanelQueueControls": true,
      "showPanelStatusBanner": true,
      "showBarHoverTrackTitle": true,
      "autoSaveMp3AfterPlayback": false,
      "ytPlayerClient": "android"
    }
  }
}
