import QtQuick
import Quickshell
import Quickshell.Io
import qs.Commons
import qs.Widgets

AtmoIconButton {
  id: root

  property var pluginApi: null
  property ShellScreen screen
  property string widgetId: ""
  property string section: ""
  property int sectionWidgetIndex: -1
  property int sectionWidgetsCount: 0

  // Parsed .index.json (regenerated by /usr/local/bin/digest-index)
  property var index: ({ "maxMtime": 0, "count": 0, "entries": [] })
  readonly property int seenMtime: pluginApi && pluginApi.pluginSettings ? (pluginApi.pluginSettings.seenMtime || 0) : 0
  readonly property bool hasNew: index.maxMtime > seenMtime && index.count > 0

  baseSize: Style.getCapsuleHeightForScreen(screen ? screen.name : "")
  applyUiScale: false
  customRadius: Style.radiusL
  colorBg: Style.capsuleColor
  colorFg: hasNew ? AtmoColor.mPrimary : AtmoColor.mOnSurface
  colorBorder: "transparent"
  colorBorderHover: "transparent"
  border.color: Style.capsuleBorderColor
  border.width: Style.capsuleBorderWidth
  icon: Icon.bell
  tooltipText: hasNew
               ? "Digests: new finds since last look (" + index.count + " total)"
               : "Digests: " + index.count + " finds, nothing new"

  onClicked: {
    if (pluginApi && pluginApi.togglePanel)
      pluginApi.togglePanel(screen, root);
  }

  FileView {
    id: indexFile
    path: Quickshell.env("HOME") + "/Digest/.index.json"
    watchChanges: true
    onFileChanged: reload()
    onLoaded: root._parse()
  }

  function _parse() {
    try { root.index = JSON.parse(indexFile.text()); }
    catch (e) { /* half-written index; keep last good */ }
  }

  // Out-of-band additions (files dropped manually): rescan every 2 min.
  // digest-index only rewrites .index.json when content actually changed,
  // so this is cheap and flicker-free.
  Timer {
    interval: 120000
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: Quickshell.execDetached(["/usr/local/bin/digest-index"])
  }
}
