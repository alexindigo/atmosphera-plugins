{
  "id": "github-feed",
  "name": "GitHub Feed",
  "version": "1.3.8",
  "minNoctaliaVersion": "3.6.0",
  "minAtmospheraVersion": "0.10.0",
  "author": "linuxmobile",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Display GitHub activity from users you follow and activity on your repos",
  "tags": [
    "Bar",
    "Panel",
    "Development",
    "Network"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "settingsSchema": {
      "version": 1,
      "fields": {
        "colorizationBadge": {"editorUsage": "configuration", "type": "String"},
        "colorizationBadgeText": {"editorUsage": "configuration", "type": "String"},
        "colorizationEnabled": {"editorUsage": "configuration", "type": "Boolean"},
        "colorizationIcon": {"editorUsage": "configuration", "type": "String"},
        "defaultTab": {"editorUsage": "configuration", "type": "Real"},
        "enableSystemNotifications": {"editorUsage": "configuration", "type": "Boolean"},
        "githubUrl": {"editorUsage": "configuration", "type": "String"},
        "maxEvents": {"editorUsage": "configuration", "type": "Real"},
        "notifyForks": {"editorUsage": "configuration", "type": "Boolean"},
        "notifyGitHubNotifications": {"editorUsage": "configuration", "type": "Boolean"},
        "notifyMyRepoForks": {"editorUsage": "configuration", "type": "Boolean"},
        "notifyMyRepoStars": {"editorUsage": "configuration", "type": "Boolean"},
        "notifyPRs": {"editorUsage": "configuration", "type": "Boolean"},
        "notifyRepoCreations": {"editorUsage": "configuration", "type": "Boolean"},
        "notifyStars": {"editorUsage": "configuration", "type": "Boolean"},
        "openInBrowser": {"editorUsage": "configuration", "type": "Boolean"},
        "refreshInterval": {"editorUsage": "configuration", "type": "Real"},
        "showForks": {"editorUsage": "configuration", "type": "Boolean"},
        "showMyRepoForks": {"editorUsage": "configuration", "type": "Boolean"},
        "showMyRepoStars": {"editorUsage": "configuration", "type": "Boolean"},
        "showNotificationBadge": {"editorUsage": "configuration", "type": "Boolean"},
        "showPRs": {"editorUsage": "configuration", "type": "Boolean"},
        "showRepoCreations": {"editorUsage": "configuration", "type": "Boolean"},
        "showStars": {"editorUsage": "configuration", "type": "Boolean"},
        "token": {"editorUsage": "configuration", "type": "String", "sensitive": true, "machineLocal": true},
        "username": {"editorUsage": "configuration", "type": "String"}
      }
    },
    "defaultSettings": {
      "username": "",
      "token": "",
      "githubUrl": "",
      "refreshInterval": 1800,
      "maxEvents": 50,
      "showStars": true,
      "showForks": true,
      "showPRs": true,
      "showRepoCreations": true,
      "showMyRepoStars": true,
      "showMyRepoForks": true,
      "showNotificationBadge": true,
      "colorizationEnabled": false,
      "colorizationIcon": "Primary",
      "colorizationBadge": "Primary",
      "colorizationBadgeText": "Primary",
      "defaultTab": 0,
      "openInBrowser": true,
      "enableSystemNotifications": false,
      "notifyGitHubNotifications": true,
      "notifyStars": true,
      "notifyForks": true,
      "notifyPRs": true,
      "notifyRepoCreations": true,
      "notifyMyRepoStars": true,
      "notifyMyRepoForks": true
    }
  }
}
