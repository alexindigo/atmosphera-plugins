{
  "id": "claude-code-panel",
  "name": "Claude Code Panel",
  "version": "0.2.3",
  "minNoctaliaVersion": "4.1.2",
  "minAtmospheraVersion": "0.10.0",
  "author": "d7om",
  "license": "MIT",
  "repository": "https://github.com/noctalia-dev/noctalia-plugins",
  "description": "Claude Code (Anthropic agentic CLI) with full tool access, permission controls, session management, MCP servers, and device integration",
  "tags": [
    "Bar",
    "Panel",
    "AI",
    "Productivity"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "panel": {
      "defaultPosition": "right",
      "detached": true,
      "defaultHeightRatio": 0.9
    },
    "settingsSchema": {
      "version": 1,
      "fields": {
        "attachmentStyle": {"type": "String"},
        "claude": {"type": "Record","fields": {"binary": {"type": "String","optional": true},"workingDir": {"type": "String","optional": true},"model": {"type": "String","optional": true},"fallbackModel": {"type": "String","optional": true},"permissionMode": {"type": "String","optional": true},"mcpConfigPath": {"type": "String","optional": true},"appendSystemPrompt": {"type": "String","optional": true},"sessionId": {"type": "String","optional": true},"injectNoctaliaContext": {"type": "Boolean","optional": true},"includePartialMessages": {"type": "Boolean","optional": true},"dangerouslySkipPermissions": {"type": "Boolean","optional": true},"autoResume": {"type": "Boolean","optional": true},"strictMcpConfig": {"type": "Boolean","optional": true},"requireConfirmBypass": {"type": "Boolean","optional": true},"allowedTools": {"type": "List","element": {"type": "String"},"optional": true},"disallowedTools": {"type": "List","element": {"type": "String"},"optional": true},"additionalDirs": {"type": "List","element": {"type": "String"},"optional": true},"maxTurns": {"type": "Real","optional": true}}},
        "maxHistoryLength": {"type": "Real"},
        "panelDetached": {"type": "Boolean"},
        "panelHeightRatio": {"type": "Real"},
        "panelPosition": {"type": "String"},
        "panelWidth": {"type": "Real"},
        "scale": {"type": "Real"}
      }
    },
    "defaultSettings": {
      "maxHistoryLength": 200,
      "panelDetached": true,
      "panelPosition": "right",
      "panelHeightRatio": 0.9,
      "panelWidth": 620,
      "scale": 1,
      "attachmentStyle": "connected",
      "claude": {
        "binary": "claude",
        "workingDir": "",
        "model": "",
        "fallbackModel": "",
        "permissionMode": "default",
        "allowedTools": [],
        "disallowedTools": [],
        "additionalDirs": [],
        "mcpConfigPath": "",
        "appendSystemPrompt": "",
        "injectNoctaliaContext": true,
        "includePartialMessages": true,
        "dangerouslySkipPermissions": false,
        "sessionId": "",
        "autoResume": true,
        "maxTurns": 0,
        "strictMcpConfig": false,
        "requireConfirmBypass": true
      }
    }
  }
}
